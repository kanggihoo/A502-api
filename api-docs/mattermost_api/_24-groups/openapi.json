{
  "openapi": "3.0.3",
  "info": {
    "title": "Mattermost Groups API (권한 필터됨)",
    "description": "AGENTS.md 실효 권한 지도 기준 포함: create_custom_group, restore_custom_group (커스텀 @멘션 그룹 생성/관리). #26은 활성 세션만 필요.",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "https://{host}/api/v4", "variables": { "host": { "default": "lab.mattermost.example.com" } } }
  ],
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer" } },
    "schemas": {
      "Group": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "display_name": { "type": "string" },
          "description": { "type": "string" },
          "source": { "type": "string" },
          "remote_id": { "type": "string" },
          "create_at": { "type": "integer" },
          "update_at": { "type": "integer" },
          "delete_at": { "type": "integer" },
          "has_syncables": { "type": "boolean" }
        }
      },
      "StatusOk": { "type": "object", "properties": { "status": { "type": "string", "example": "ok" } } }
    }
  },
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/groups": {
      "post": {
        "summary": "3. Create a custom group (create_custom_group, 서버 6.3+)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "display_name": { "type": "string" },
                  "source": { "type": "string", "enum": ["custom"] },
                  "allow_reference": { "type": "boolean", "enum": [true] },
                  "user_ids": { "type": "array", "items": { "type": "string" } }
                },
                "required": ["name", "display_name", "source", "allow_reference", "user_ids"]
              },
              "example": { "name": "a502", "display_name": "A502팀", "source": "custom", "allow_reference": true, "user_ids": ["{{my_user_id}}"] }
            }
          }
        },
        "responses": { "201": { "description": "Group created" } }
      }
    },
    "/groups/{group_id}/restore": {
      "post": {
        "summary": "7. Restore a previously deleted group (restore_custom_group, 서버 7.7+)",
        "parameters": [{ "name": "group_id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StatusOk" } } } } }
      }
    },
    "/groups/names": {
      "post": {
        "summary": "26. Get groups by name (활성 세션만 필요, 서버 11.0+)",
        "requestBody": { "content": { "application/json": { "schema": { "type": "array", "items": { "type": "string" } } } } },
        "responses": { "200": { "description": "Group list", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Group" } } } } } }
      }
    }
  }
}
