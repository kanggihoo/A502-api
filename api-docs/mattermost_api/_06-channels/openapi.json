  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "`Authorization: Bearer <token>`. 세션 토큰 또는 개인 액세스 토큰을 사용한다."
      }
    },
    "parameters": {
      "UserIdOrMe": {
        "name": "user_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "description": "사용자 GUID. 문자열 `me` 를 넣으면 현재 로그인 사용자를 가리킨다.",
        "example": "me"
      },
      "TeamId": {
        "name": "team_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "description": "팀 GUID"
      },
      "ChannelId": {
        "name": "channel_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "description": "채널 GUID"
      },
      "CategoryId": {
        "name": "category_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "description": "사이드바 카테고리 GUID"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "잘못된 요청",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AppError" } } }
      },
      "Unauthorized": {
        "description": "인증 실패 또는 세션 만료",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AppError" } } }
      },
      "Forbidden": {
        "description": "권한 부족",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AppError" } } }
      },
      "NotFound": {
        "description": "리소스를 찾을 수 없음",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AppError" } } }
      },
      "NotImplemented": {
        "description": "서버 버전 또는 설정상 해당 기능이 지원되지 않음",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AppError" } } }
      }
    },
    "schemas": {
      "AppError": {
        "type": "object",
        "description": "Mattermost 공통 오류 응답",
        "properties": {
          "status_code": { "type": "integer", "description": "HTTP 상태 코드" },
          "id": { "type": "string", "description": "오류 식별자" },
          "message": { "type": "string", "description": "사람이 읽을 수 있는 오류 메시지" },
          "request_id": { "type": "string", "description": "요청 추적용 ID" }
        }
      },
      "StatusOK": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "ok", "description": "요청이 성공했고 반환할 다른 내용이 없으면 `\"ok\"` 가 담긴다." }
        }
      },
      "Channel": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "채널 GUID" },
          "create_at": { "type": "integer", "format": "int64", "description": "채널이 생성된 시각(밀리초)" },
          "update_at": { "type": "integer", "format": "int64", "description": "채널이 마지막으로 갱신된 시각(밀리초)" },
          "delete_at": { "type": "integer", "format": "int64", "description": "채널이 삭제된 시각(밀리초). 활성 채널은 0." },
          "team_id": { "type": "string", "description": "채널이 속한 팀 ID. DM/GM 채널은 빈 문자열." },
          "type": { "type": "string", "description": "채널 타입. `O`=공개, `P`=비공개, `D`=DM, `G`=그룹 메시지." },
          "display_name": { "type": "string", "description": "UI에 표시되는 채널 이름" },
          "name": { "type": "string", "description": "채널 URL에 노출되는 고유 handle" },
          "header": { "type": "string", "description": "채널 헤더 텍스트(Markdown)" },
          "purpose": { "type": "string", "description": "채널 목적 설명" },
          "last_post_at": { "type": "integer", "format": "int64", "description": "채널의 마지막 게시물 시각(밀리초)" },
          "total_msg_count": { "type": "integer", "description": "채널 전체 메시지 수" },
          "extra_update_at": { "type": "integer", "format": "int64", "description": "Deprecated (Mattermost 5.0에서 폐기)" },
          "creator_id": { "type": "string", "description": "채널을 만든 사용자 ID" }
        }
      },
      "ChannelNotifyProps": {
        "type": "object",
        "description": "채널별 알림 설정. 값이 모두 문자열임에 주의. `\"default\"` 를 넣으면 사용자 전역 설정을 따른다.",
        "properties": {
          "email": { "type": "string", "description": "이메일 알림. `\"true\"`/`\"false\"`/`\"default\"`(전역 설정 사용)." },
          "push": { "type": "string", "description": "푸시 알림. `\"all\"`(모든 활동), `\"mention\"`(멘션·DM만), `\"none\"`(끔), `\"default\"`(전역 설정 사용)." },
          "desktop": { "type": "string", "description": "데스크톱 알림. `\"all\"`, `\"mention\"`, `\"none\"`, `\"default\"`." },
          "mark_unread": { "type": "string", "description": "미확인 표시 기준. `\"all\"`(새 메시지마다), `\"mention\"`(새 멘션만). 기본값 `\"all\"`." }
        }
      },
      "ChannelMember": {
        "type": "object",
        "properties": {
          "channel_id": { "type": "string", "description": "채널 ID" },
          "user_id": { "type": "string", "description": "사용자 ID" },
          "roles": { "type": "string", "description": "이 채널 멤버에게 부여된 역할 목록(공백 구분). 예: `channel_user`, `channel_admin`." },
          "last_viewed_at": { "type": "integer", "format": "int64", "description": "사용자가 채널을 마지막으로 본 시각(밀리초)" },
          "msg_count": { "type": "integer", "description": "마지막으로 본 시점까지의 메시지 수" },
          "mention_count": { "type": "integer", "description": "읽지 않은 멘션 수" },
          "notify_props": { "$ref": "#/components/schemas/ChannelNotifyProps" },
          "last_update_at": { "type": "integer", "format": "int64", "description": "채널 멤버가 마지막으로 갱신된 시각(밀리초)" }
        }
      },
      "ChannelViewResponse": {
        "type": "object",
        "description": "읽음 처리 계열 API(39, 41, 42)의 공통 응답",
        "properties": {
          "status": { "type": "string", "description": "성공 시 `\"OK\"`" },
          "last_viewed_at_times": { "type": "object", "description": "채널 ID를 키로, 해당 채널을 본 시각(밀리초)을 값으로 갖는 객체. Mattermost 4.3 이상에서만 포함된다.", "additionalProperties": { "type": "integer", "format": "int64" } }
        }
      },
      "PostList": {
        "type": "object",
        "description": "Mattermost 표준 게시물 목록 응답. 순서는 `order` 가, 내용은 `posts` 맵이 담는다.",
        "properties": {
          "order": { "type": "array", "items": { "type": "string" }, "description": "게시물 ID의 표시 순서" },
          "posts": { "type": "object", "description": "게시물 ID를 키로, Post 객체를 값으로 갖는 맵" },
          "next_post_id": { "type": "string", "description": "다음 게시물의 ID. 비어 있거나 해당 없어도 생략되지 않는다." },
          "prev_post_id": { "type": "string", "description": "이전 게시물의 ID. 비어 있거나 해당 없어도 생략되지 않는다." },
          "has_next": { "type": "boolean", "description": "이 페이지 다음에 더 많은 항목이 있는지 여부" }
        }
      },
      "SidebarCategory": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "카테고리 GUID" },
          "user_id": { "type": "string", "description": "카테고리 소유 사용자 ID" },
          "team_id": { "type": "string", "description": "카테고리가 속한 팀 ID" },
          "display_name": { "type": "string", "description": "카테고리 표시 이름" },
          "type": { "type": "string", "enum": ["channels", "custom", "direct_messages", "favorites"], "description": "카테고리 타입. 삭제(59번)는 `custom` 만 가능." }
        }
      },
      "SidebarCategoryWithChannels": {
        "allOf": [
          { "$ref": "#/components/schemas/SidebarCategory" },
          {
            "type": "object",
            "properties": {
              "channel_ids": { "type": "array", "items": { "type": "string" }, "description": "이 카테고리에 속한 채널 ID 목록" }
            }
          }
        ]
      }
    }
  }
}
