{
  "openapi": "3.0.3",
  "info": {
    "title": "Mattermost Properties API (권한 필터됨)",
    "description": "AGENTS.md 실효 권한 지도 기준 포함: read_channel(채널 스코프), view_team(팀 스코프), system 스코프는 인증만 필요. field/value 정의 생성·수정은 시스템 관리자 성격으로 보수적으로 제외.",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "https://{host}/api/v4", "variables": { "host": { "default": "lab.mattermost.example.com" } } }
  ],
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer" } },
    "schemas": {
      "PropertyField": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["text", "select", "multiselect"] },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "create_at": { "type": "integer" },
          "update_at": { "type": "integer" },
          "delete_at": { "type": "integer" },
          "attrs": { "type": "object" }
        }
      },
      "PropertyValue": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "field_id": { "type": "string" },
          "value": { "type": "string" },
          "create_at": { "type": "integer" },
          "update_at": { "type": "integer" },
          "delete_at": { "type": "integer" }
        }
      }
    }
  },
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/properties/groups/{group_name}/{object_type}/fields": {
      "get": {
        "summary": "2. Get property fields (계층 스코프: read_channel/view_team, 커서 페이지네이션)",
        "parameters": [
          { "name": "group_name", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "object_type", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "channel_id", "in": "query", "schema": { "type": "string" } },
          { "name": "team_id", "in": "query", "schema": { "type": "string" } },
          { "name": "target_type", "in": "query", "schema": { "type": "string" } },
          { "name": "target_id", "in": "query", "schema": { "type": "string" } },
          { "name": "since", "in": "query", "schema": { "type": "integer" } },
          { "name": "cursor_id", "in": "query", "schema": { "type": "string" } },
          { "name": "cursor_create_at", "in": "query", "schema": { "type": "integer" } },
          { "name": "cursor_update_at", "in": "query", "schema": { "type": "integer" } },
          { "name": "per_page", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Property field list", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/PropertyField" } } } } } }
      }
    },
    "/properties/groups/{group_name}/fields/search": {
      "post": {
        "summary": "3. Search property fields across multiple object types (계층 스코프: read_channel/view_team)",
        "parameters": [{ "name": "group_name", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "object_types": { "type": "array", "items": { "type": "string", "enum": ["post", "channel", "user", "template", "system"] } },
                  "channel_id": { "type": "string" },
                  "team_id": { "type": "string" },
                  "target_type": { "type": "string" },
                  "target_id": { "type": "string" },
                  "since": { "type": "integer" },
                  "per_page": { "type": "integer" }
                },
                "required": ["object_types"]
              }
            }
          }
        },
        "responses": { "200": { "description": "Property field list", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/PropertyField" } } } } } }
      }
    },
    "/properties/groups/{group_name}/{object_type}/values/{target_id}": {
      "get": {
        "summary": "6. Get property values for a target (대상 리소스 접근 권한, 커서 페이지네이션)",
        "parameters": [
          { "name": "group_name", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "object_type", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "target_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "since", "in": "query", "schema": { "type": "integer" } },
          { "name": "cursor_id", "in": "query", "schema": { "type": "string" } },
          { "name": "cursor_create_at", "in": "query", "schema": { "type": "integer" } },
          { "name": "cursor_update_at", "in": "query", "schema": { "type": "integer" } },
          { "name": "per_page", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Property value list", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/PropertyValue" } } } } } }
      }
    },
    "/properties/groups/{group_name}/system/values": {
      "get": {
        "summary": "8. Get property values for the system (인증만 필요)",
        "parameters": [
          { "name": "group_name", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "since", "in": "query", "schema": { "type": "integer" } },
          { "name": "cursor_id", "in": "query", "schema": { "type": "string" } },
          { "name": "cursor_create_at", "in": "query", "schema": { "type": "integer" } },
          { "name": "cursor_update_at", "in": "query", "schema": { "type": "integer" } },
          { "name": "per_page", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "System property value list", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/PropertyValue" } } } } } }
      }
    }
  }
}
