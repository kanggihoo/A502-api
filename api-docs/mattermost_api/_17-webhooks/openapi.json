            "application/json": {
              "schema": {
                "type": "object",
                "required": ["id", "channel_id", "display_name", "description"],
                "properties": {
                  "id": { "type": "string", "description": "outgoing webhook GUID. 경로 파라미터와 동일한 값." },
                  "channel_id": { "type": "string", "description": "이 웹훅이 감시할 공개 채널의 ID" },
                  "display_name": { "type": "string", "description": "이 outgoing webhook의 표시 이름" },
                  "description": { "type": "string", "description": "이 outgoing webhook의 설명" },
                  "trigger_words": { "type": "array", "items": { "type": "string" }, "description": "웹훅을 발동시킬 단어 목록. **원문 요청 스키마에는 없으나 응답에 포함되는 필드** — 실호출 확인 필요." },
                  "trigger_when": { "type": "integer", "enum": [0, 1], "description": "발동 조건. **원문 요청 스키마에는 없는 필드** — 실호출 확인 필요." },
                  "callback_urls": { "type": "array", "items": { "type": "string" }, "description": "발동 시 payload를 POST할 URL 목록. **원문 요청 스키마에는 없는 필드** — 실호출 확인 필요." },
                  "content_type": { "type": "string", "enum": ["application/json", "application/x-www-form-urlencoded"], "description": "POST할 데이터 형식. **원문 요청 스키마에는 없는 필드** — 실호출 확인 필요." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "웹훅 갱신 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OutgoingWebhook" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
