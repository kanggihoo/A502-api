{
  "openapi": "3.0.3",
  "info": {
    "title": "Mattermost Webhooks API (권한 필터됨)",
    "description": "AGENTS.md 실효 권한 지도 기준 포함: manage_own_incoming_webhooks, manage_own_outgoing_webhooks (본인 생성분 한정). bypass_incoming_webhook_channel_lock 권한도 있어 webhook 1개로 여러 채널 발송 가능. 타인 소유 webhook 관리(manage_others_*)는 제외.",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "https://{host}/api/v4", "variables": { "host": { "default": "lab.mattermost.example.com" } } }
  ],
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer" } },
    "schemas": {
      "IncomingWebhook": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "create_at": { "type": "integer" },
          "update_at": { "type": "integer" },
          "delete_at": { "type": "integer" },
          "last_used": { "type": "integer" },
          "channel_id": { "type": "string" },
          "description": { "type": "string" },
          "display_name": { "type": "string" },
          "username": { "type": "string" },
          "icon_url": { "type": "string" },
          "channel_locked": { "type": "boolean" }
        }
      },
      "OutgoingWebhook": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "create_at": { "type": "integer" },
          "update_at": { "type": "integer" },
          "delete_at": { "type": "integer" },
          "creator_id": { "type": "string" },
          "team_id": { "type": "string" },
          "channel_id": { "type": "string" },
          "description": { "type": "string" },
          "display_name": { "type": "string" },
          "trigger_words": { "type": "array", "items": { "type": "string" } },
          "trigger_when": { "type": "integer", "enum": [0, 1] },
          "callback_urls": { "type": "array", "items": { "type": "string" } },
          "content_type": { "type": "string" }
        }
      },
      "StatusOk": { "type": "object", "properties": { "status": { "type": "string", "example": "ok" } } }
    }
  },
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/hooks/incoming": {
      "post": {
        "summary": "1. Create an incoming webhook (manage_own_incoming_webhooks)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "channel_id": { "type": "string" },
                  "display_name": { "type": "string" },
                  "description": { "type": "string" },
                  "username": { "type": "string" },
                  "icon_url": { "type": "string" },
                  "channel_locked": { "type": "boolean" }
                },
                "required": ["channel_id"]
              },
              "example": { "channel_id": "{{channel_id}}", "display_name": "A502 알림봇", "description": "SSAGY 통합 알림용 incoming webhook" }
            }
          }
        },
        "responses": { "201": { "description": "Incoming webhook created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IncomingWebhook" } } } } }
      },
      "get": {
        "summary": "2. List incoming webhooks (본인 소유 범위)",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer" } },
          { "name": "per_page", "in": "query", "schema": { "type": "integer" } },
          { "name": "team_id", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Webhook list", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/IncomingWebhook" } } } } } }
      }
    },
    "/hooks/incoming/{hook_id}": {
      "get": {
        "summary": "3. Get an incoming webhook (본인)",
        "parameters": [{ "name": "hook_id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Webhook", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IncomingWebhook" } } } } }
      },
      "delete": {
        "summary": "4. Delete an incoming webhook (본인)",
        "parameters": [{ "name": "hook_id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StatusOk" } } } } }
      },
      "put": {
        "summary": "5. Update an incoming webhook (본인)",
        "parameters": [{ "name": "hook_id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "channel_id": { "type": "string" },
                  "display_name": { "type": "string" },
                  "description": { "type": "string" },
                  "username": { "type": "string" },
                  "icon_url": { "type": "string" },
                  "channel_locked": { "type": "boolean" }
                },
                "required": ["id", "channel_id", "display_name", "description"]
              }
            }
          }
        },
        "responses": { "200": { "description": "Updated webhook", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IncomingWebhook" } } } } }
      }
    },
    "/hooks/outgoing": {
      "post": {
        "summary": "6. Create an outgoing webhook (manage_own_outgoing_webhooks)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "team_id": { "type": "string" },
                  "channel_id": { "type": "string" },
                  "display_name": { "type": "string" },
                  "description": { "type": "string" },
                  "trigger_words": { "type": "array", "items": { "type": "string" } },
                  "trigger_when": { "type": "integer", "enum": [0, 1] },
                  "callback_urls": { "type": "array", "items": { "type": "string" } },
                  "content_type": { "type": "string", "enum": ["application/json", "application/x-www-form-urlencoded"] }
                },
                "required": ["team_id", "display_name", "trigger_words", "callback_urls"]
              }
            }
          }
        },
        "responses": { "201": { "description": "Outgoing webhook created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OutgoingWebhook" } } } } }
      },
      "get": {
        "summary": "7. List outgoing webhooks (본인 소유 범위)",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer" } },
          { "name": "per_page", "in": "query", "schema": { "type": "integer" } },
          { "name": "team_id", "in": "query", "schema": { "type": "string" } },
          { "name": "channel_id", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Webhook list", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/OutgoingWebhook" } } } } } }
      }
    },
    "/hooks/outgoing/{hook_id}": {
      "get": {
        "summary": "8. Get an outgoing webhook (본인)",
        "parameters": [{ "name": "hook_id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Webhook", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OutgoingWebhook" } } } } }
      },
      "delete": {
        "summary": "9. Delete an outgoing webhook (본인)",
        "parameters": [{ "name": "hook_id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StatusOk" } } } } }
      },
      "put": {
        "summary": "10. Update an outgoing webhook (본인)",
        "parameters": [{ "name": "hook_id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "type": "object", "properties": { "id": { "type": "string" }, "channel_id": { "type": "string" }, "display_name": { "type": "string" }, "description": { "type": "string" } }, "required": ["id", "channel_id", "display_name", "description"] }
            }
          }
        },
        "responses": { "200": { "description": "Updated webhook", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OutgoingWebhook" } } } } }
      }
    },
    "/hooks/outgoing/{hook_id}/regen_token": {
      "post": {
        "summary": "11. Regenerate the token for the outgoing webhook (본인)",
        "parameters": [{ "name": "hook_id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StatusOk" } } } } }
      }
    }
  }
}
