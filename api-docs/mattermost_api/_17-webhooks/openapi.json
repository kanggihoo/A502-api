          "delete_at": { "type": "integer", "format": "int64", "description": "웹훅이 삭제된 시각(밀리초). 활성 웹훅은 0." },
          "last_used": { "type": "integer", "format": "int64", "description": "이 웹훅이 마지막으로 메시지 발송에 사용된 시각(밀리초). 발송이 실제로 이뤄지는지 점검하는 데 쓴다." },
          "channel_id": { "type": "string", "description": "웹훅 payload를 받는 공개 채널 또는 비공개 그룹의 ID" },
          "description": { "type": "string", "description": "이 incoming webhook의 설명" },
          "display_name": { "type": "string", "description": "이 incoming webhook의 표시 이름" }
        }
      },
      "OutgoingWebhook": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "이 outgoing webhook의 고유 식별자" },
          "create_at": { "type": "integer", "format": "int64", "description": "웹훅이 생성된 시각(밀리초)" },
          "update_at": { "type": "integer", "format": "int64", "description": "웹훅이 마지막으로 갱신된 시각(밀리초)" },
          "delete_at": { "type": "integer", "format": "int64", "description": "웹훅이 삭제된 시각(밀리초). 활성 웹훅은 0." },
          "creator_id": { "type": "string", "description": "웹훅을 만든 사용자 ID" },
          "team_id": { "type": "string", "description": "이 웹훅이 감시하는 팀의 ID" },
          "channel_id": { "type": "string", "description": "이 웹훅이 감시하는 공개 채널의 ID" },
          "description": { "type": "string", "description": "이 outgoing webhook의 설명" },
          "display_name": { "type": "string", "description": "이 outgoing webhook의 표시 이름" },
          "trigger_words": { "type": "array", "items": { "type": "string" }, "description": "웹훅을 발동시키는 단어 목록" },
          "trigger_when": { "type": "integer", "enum": [0, 1], "description": "발동 조건. `0`=트리거 단어가 메시지 어디에든 있으면, `1`=메시지가 트리거 단어로 시작할 때만." },
          "callback_urls": { "type": "array", "items": { "type": "string" }, "description": "발동 시 payload를 POST할 URL 목록" },
          "content_type": { "type": "string", "description": "POST할 데이터 형식. `application/json` 또는 `application/x-www-form-urlencoded`." }
        }
      }
    }
