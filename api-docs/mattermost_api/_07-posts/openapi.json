        "properties": {
          "order": { "type": "array", "items": { "type": "string" }, "description": "게시물 ID의 표시 순서" },
          "posts": { "type": "object", "description": "게시물 ID를 키로, Post 객체를 값으로 갖는 맵", "additionalProperties": { "$ref": "#/components/schemas/Post" } },
          "matches": { "type": "object", "description": "게시물 ID를 키로, 그 안에서 매칭된 검색어 목록을 값으로 갖는 맵. **Elasticsearch가 활성화된 5.1 이상 서버에서만 채워진다.**", "additionalProperties": { "type": "array", "items": { "type": "string" } } }
        }
      },
      "FileInfo": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "파일 고유 식별자" },
