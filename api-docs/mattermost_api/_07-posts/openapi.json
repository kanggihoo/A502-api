                  "terms": { "type": "string", "description": "사용자가 입력한 검색어. 작성자 지정은 `from:someusername`, 채널 지정은 `in:somechannel`(표시 이름이 아닌 채널 `name`)." },
                  "is_or_search": { "type": "boolean", "description": "true면 OR 검색, false면 AND 검색" },
                  "time_zone_offset": { "type": "integer", "description": "날짜 검색에 사용할 사용자 시간대의 UTC 오프셋" },
                  "include_deleted_channels": { "type": "boolean", "description": "삭제(아카이브)된 채널도 검색에 포함할지 여부" },
                  "page": { "type": "integer", "description": "조회할 페이지 번호. Elasticsearch 사용 시에만 동작." },
                  "per_page": { "type": "integer", "description": "페이지당 게시물 수. Elasticsearch 사용 시에만 동작." }
