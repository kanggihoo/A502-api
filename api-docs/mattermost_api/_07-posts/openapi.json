        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "게시물 GUID" },
          "create_at": { "type": "integer", "format": "int64", "description": "게시물이 생성된 시각(밀리초)" },
          "update_at": { "type": "integer", "format": "int64", "description": "게시물이 마지막으로 갱신된 시각(밀리초)" },
          "delete_at": { "type": "integer", "format": "int64", "description": "게시물이 삭제된 시각(밀리초). 활성 게시물은 0." },
          "edit_at": { "type": "integer", "format": "int64", "description": "게시물이 편집된 시각(밀리초). 편집된 적 없으면 0." },
          "user_id": { "type": "string", "description": "작성자 사용자 ID" },
          "channel_id": { "type": "string", "description": "게시물이 속한 채널 ID" },
          "root_id": { "type": "string", "description": "스레드 답글인 경우 루트 게시물 ID. 루트 게시물이면 빈 문자열." },
          "original_id": { "type": "string", "description": "원본 게시물 ID(편집 이력 추적용)" },
