        "x-permissions": "해당 채널에 대한 `read_channel` 권한 필요.",
        "parameters": [
          { "$ref": "#/components/parameters/ChannelId" },
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "default": 0 }, "description": "조회할 페이지 번호(0부터)" },
          { "name": "per_page", "in": "query", "required": false, "schema": { "type": "integer", "default": 60 }, "description": "페이지당 게시물 수" },
          { "name": "since", "in": "query", "required": false, "schema": { "type": "integer", "format": "int64" }, "description": "Unix 밀리초. 이 시각 이후 수정된 게시물만 선택한다. `before`/`after`/`page`/`per_page` 와 함께 쓸 수 없다." },
          { "name": "before", "in": "query", "required": false, "schema": { "type": "string" }, "description": "이 게시물 이전의 게시물들을 선택할 기준 post id" },
          { "name": "after", "in": "query", "required": false, "schema": { "type": "string" }, "description": "이 게시물 이후의 게시물들을 선택할 기준 post id" },
          { "name": "include_deleted", "in": "query", "required": false, "schema": { "type": "boolean" }, "description": "삭제된 게시물 포함 여부. 시스템 관리자 권한 필요." },
          { "name": "type", "in": "query", "required": false, "schema": { "type": "string" }, "description": "게시물 타입으로 필터링" }
