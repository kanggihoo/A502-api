{
  "openapi": "3.0.3",
  "info": {
    "title": "Mattermost API - _51-group-message",
    "version": "1.0.0",
    "description": "Mattermost Group Message API. SSAGY 연동 계정(`system_user` + `team_user` + `channel_user`)으로 전 항목 호출 가능하다.\n\n**포함 기준**: 01, 02 (총 2건 — 디렉토리 전체).\n\n**연동 활용**\n`_06-channels` 05번으로 만든 그룹 메시지(GM) 채널이 커져 정식 채널로 승격해야 할 때 02번을 쓴다. GM은 팀에 속하지 않으므로 승격 시 대상 팀을 지정해야 하는데, 01번으로 **GM 멤버 전원이 공통으로 속한 팀**을 먼저 찾아 그 중에서 고르는 것이 안전한 순서다.\n\n**02번은 되돌릴 수 없다.** 비공개 채널로 전환된 뒤에는 GM으로 되돌리는 API가 없으므로, 실행 전 사용자 확인을 받을 것.\n\n**공통 규칙**\n- 타임스탬프 계열 필드는 Unix epoch **밀리초** 정수다.\n- 오류 응답 본문은 모두 `AppError` 스키마를 따른다.\n\n**x-priority 의미**: SSAGY(통합 워크스페이스) 관점의 연동 우선순위."
  },
  "servers": [
    {
      "url": "https://{host}/api/v4",
      "variables": {
        "host": {
          "default": "meeting.ssafy.com",
          "description": "self-hosted Mattermost 호스트"
        }
      }
    }
  ],
  "security": [{ "bearerAuth": [] }],
  "tags": [{ "name": "Group Message", "description": "그룹 메시지 채널 공통 팀 조회 및 채널 승격" }],
  "paths": {
    "/channels/{channel_id}/common_teams": {
      "get": {
        "summary": "01. Get common teams for members of a Group Message",
        "description": "그룹 메시지(GM) 채널의 활성 멤버 전원이 공통으로 속한 팀을 모두 조회한다. 공통 팀이 없으면 빈 배열을 반환한다.\n\n**02번을 호출하기 전 사용할 것.** GM을 비공개 채널로 승격하려면 대상 팀이 필요한데, 멤버 전원이 속하지 않은 팀을 고르면 일부 멤버가 채널에 남지 못한다.\n\n최소 서버 버전 9.1",
        "operationId": "getGroupMessageMembersCommonTeams",
        "tags": ["Group Message"],
        "x-priority": "medium",
        "x-permissions": "인증 + 해당 채널에 대한 `read_channel` 권한 필요(`channel_user` 에 포함).",
        "parameters": [
          { "name": "channel_id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "그룹 메시지 채널 GUID" }
        ],
        "responses": {
          "200": {
            "description": "공통 팀 조회 성공. 공통 팀이 없으면 빈 배열.",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Team" } } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/channels/{channel_id}/convert_to_channel": {
      "post": {
        "summary": "02. Convert group message to private channel",
        "description": "그룹 메시지 채널을 지정한 팀의 **비공개 채널로 전환**한다.\n\n**⚠️ 되돌릴 수 없는 작업이다.** 전환 후 GM으로 복구하는 API가 없으므로, 실행 전 사용자 확인을 받을 것.\n\n대상 팀은 01번으로 확인한 공통 팀 중에서 고른다. 요청 본문의 `channel_id` 는 경로 파라미터와 같은 값을 넣는다.",
        "operationId": "convertGroupMessageToPrivateChannel",
        "tags": ["Group Message"],
        "x-priority": "medium",
        "x-permissions": "대상 팀에서 `create_private_channel` 권한 필요(`team_user` 에 포함).",
        "parameters": [
          { "name": "channel_id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "그룹 메시지 채널 ID" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["channel_id", "team_id"],
                "properties": {
                  "channel_id": { "type": "string", "description": "전환할 그룹 메시지 채널 ID. 경로 파라미터와 동일한 값." },
                  "team_id": { "type": "string", "description": "전환 후 채널이 속할 팀 ID. 01번으로 확인한 공통 팀 중에서 고를 것." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "전환 성공. 비공개 채널(`type: \"P\"`)로 바뀐 Channel 객체가 반환된다.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Channel" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "`Authorization: Bearer <token>`. 세션 토큰 또는 개인 액세스 토큰을 사용한다."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "잘못된 요청",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AppError" } } }
      },
      "Unauthorized": {
        "description": "인증 실패 또는 세션 만료",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AppError" } } }
      },
      "Forbidden": {
        "description": "권한 부족",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AppError" } } }
      },
      "NotFound": {
        "description": "채널을 찾을 수 없음",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AppError" } } }
      }
    },
    "schemas": {
      "AppError": {
        "type": "object",
        "description": "Mattermost 공통 오류 응답",
        "properties": {
          "status_code": { "type": "integer", "description": "HTTP 상태 코드" },
          "id": { "type": "string", "description": "오류 식별자" },
          "message": { "type": "string", "description": "사람이 읽을 수 있는 오류 메시지" },
          "request_id": { "type": "string", "description": "요청 추적용 ID" }
        }
      },
      "Team": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "팀 GUID" },
          "create_at": { "type": "integer", "format": "int64", "description": "팀이 생성된 시각(밀리초)" },
          "update_at": { "type": "integer", "format": "int64", "description": "팀이 마지막으로 갱신된 시각(밀리초)" },
          "delete_at": { "type": "integer", "format": "int64", "description": "팀이 삭제된 시각(밀리초). 활성 팀은 0." },
          "display_name": { "type": "string", "description": "팀 표시 이름" },
          "name": { "type": "string", "description": "팀 이름(URL slug)" },
          "description": { "type": "string", "description": "팀 설명" },
          "email": { "type": "string", "description": "팀 대표 이메일" },
          "type": { "type": "string", "description": "팀 타입. `O`=open(공개), `I`=invite only(초대 전용)." },
          "allowed_domains": { "type": "string", "description": "가입 허용 이메일 도메인 목록" },
          "invite_id": { "type": "string", "description": "팀 초대 ID" },
          "allow_open_invite": { "type": "boolean", "description": "링크를 통한 자유 가입 허용 여부" },
          "policy_id": { "type": "string", "nullable": true, "description": "이 팀에 할당된 데이터 보존 정책 ID. 정책이 없거나 권한이 없으면 null." }
        }
      },
      "Channel": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "채널 GUID" },
          "create_at": { "type": "integer", "format": "int64", "description": "채널이 생성된 시각(밀리초)" },
          "update_at": { "type": "integer", "format": "int64", "description": "채널이 마지막으로 갱신된 시각(밀리초)" },
          "delete_at": { "type": "integer", "format": "int64", "description": "채널이 삭제된 시각(밀리초). 활성 채널은 0." },
          "team_id": { "type": "string", "description": "채널이 속한 팀 ID. 전환 후에는 지정한 팀 ID가 들어간다." },
          "type": { "type": "string", "description": "채널 타입. 전환 후에는 `P`(비공개)." },
          "display_name": { "type": "string", "description": "UI에 표시되는 채널 이름" },
          "name": { "type": "string", "description": "채널 URL에 노출되는 고유 handle" },
          "header": { "type": "string", "description": "채널 헤더 텍스트" },
          "purpose": { "type": "string", "description": "채널 목적 설명" },
          "last_post_at": { "type": "integer", "format": "int64", "description": "채널의 마지막 게시물 시각(밀리초)" },
          "total_msg_count": { "type": "integer", "description": "채널 전체 메시지 수" },
          "extra_update_at": { "type": "integer", "format": "int64", "description": "Deprecated (Mattermost 5.0에서 폐기)" },
          "creator_id": { "type": "string", "description": "채널을 만든 사용자 ID" }
        }
      }
    }
  }
}
