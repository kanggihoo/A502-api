{
  "openapi": "3.0.3",
  "info": {
    "title": "Jira API - _89-user-search",
    "version": "1.0.0",
    "description": "Jira 사용자를 다양한 조건(프로젝트/이슈 할당 가능 여부, 권한 보유 여부, 검색어, 구조화된 쿼리 등)으로 검색하는 API 모음. 팀 생성 자동화 시 담당자/워처 후보를 찾거나, 통합 알림·대시보드에서 이슈 관련 사용자(assignee, watcher, commenter 등)를 조회하는 데 활용할 수 있다."
  },
  "servers": [
    {
      "url": "https://{siteName}.atlassian.net",
      "variables": {
        "siteName": {
          "default": "ssafy",
          "description": "Jira Cloud 사이트 이름 (예: ssafy.atlassian.net)"
        }
      }
    }
  ],
  "security": [
    { "basicAuth": [] },
    { "oauth2": ["read:jira-work", "write:jira-work"] }
  ],
  "tags": [
    { "name": "User search", "description": "Jira 사용자 검색 API" }
  ],
  "paths": {
    "/rest/api/3/user/assignable/multiProjectSearch": {
      "get": {
        "summary": "Find users assignable to projects",
        "description": "주어진 프로젝트들에서 이슈에 배정 가능한 사용자를 검색어(query) 또는 정확한 accountId로 찾는다. startAt/maxResults 범위 내 사용자 중 배정 가능한 사용자만 반환되므로 응답 개수가 maxResults보다 적을 수 있다. 사용자 프라이버시 설정에 따라 이메일 등 일부 필드가 숨겨질 수 있다.",
        "operationId": "findUsersAssignableToProjects",
        "tags": ["User search"],
        "x-priority": "high",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "displayName, emailAddress의 접두사와 매칭되는 검색어. accountId 미지정 시 필수",
            "example": "john"
          },
          {
            "name": "username",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "더 이상 사용되지 않음 (deprecated)"
          },
          {
            "name": "accountId",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "정확히 일치하는 사용자 accountId. query 미지정 시 필수",
            "example": "5b10a2844c20165700ede21g"
          },
          {
            "name": "projectKeys",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "쉼표로 구분된 프로젝트 키 목록 (대소문자 구분)",
            "example": "PROJ1,PROJ2"
          },
          {
            "name": "startAt",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 0 },
            "description": "페이지 오프셋",
            "example": 0
          },
          {
            "name": "maxResults",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 50 },
            "description": "페이지당 최대 항목 수",
            "example": 50
          }
        ],
        "responses": {
          "200": {
            "description": "요청 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "accountId": { "type": "string", "description": "사용자 계정 ID" },
                      "accountType": { "type": "string", "description": "계정 유형" },
                      "active": { "type": "boolean", "description": "활성 여부" },
                      "avatarUrls": {
                        "type": "object",
                        "description": "아바타 URL 모음",
                        "properties": {
                          "16x16": { "type": "string" },
                          "24x24": { "type": "string" },
                          "32x32": { "type": "string" },
                          "48x48": { "type": "string" }
                        }
                      },
                      "displayName": { "type": "string", "description": "표시 이름" },
                      "key": { "type": "string", "description": "deprecated" },
                      "name": { "type": "string", "description": "deprecated" },
                      "self": { "type": "string", "description": "사용자 리소스 URL" }
                    }
                  }
                },
                "example": [
                  {
                    "accountId": "5b10a2844c20165700ede21g",
                    "accountType": "atlassian",
                    "active": false,
                    "avatarUrls": {
                      "16x16": "https://avatar-management--avatars.server-location.prod.public.atl-paas.net/initials/MK-5.png?size=16&s=16",
                      "24x24": "https://avatar-management--avatars.server-location.prod.public.atl-paas.net/initials/MK-5.png?size=24&s=24",
                      "32x32": "https://avatar-management--avatars.server-location.prod.public.atl-paas.net/initials/MK-5.png?size=32&s=32",
                      "48x48": "https://avatar-management--avatars.server-location.prod.public.atl-paas.net/initials/MK-5.png?size=48&s=48"
                    },
                    "displayName": "Mia Krystof",
                    "key": "",
                    "name": "",
                    "self": "https://your-domain.atlassian.net/rest/api/3/user?accountId=5b10a2844c20165700ede21g"
                  },
                  {
                    "accountId": "5b10ac8d82e05b22cc7d4ef5",
                    "accountType": "atlassian",
                    "active": false,
                    "avatarUrls": {
                      "16x16": "https://avatar-management--avatars.server-location.prod.public.atl-paas.net/initials/AA-3.png?size=16&s=16",
                      "24x24": "https://avatar-management--avatars.server-location.prod.public.atl-paas.net/initials/AA-3.png?size=24&s=24",
                      "32x32": "https://avatar-management--avatars.server-location.prod.public.atl-paas.net/initials/AA-3.png?size=32&s=32",
                      "48x48": "https://avatar-management--avatars.server-location.prod.public.atl-paas.net/initials/AA-3.png?size=48&s=48"
                    },
                    "displayName": "Emma Richards",
                    "key": "",
                    "name": "",
                    "self": "https://your-domain.atlassian.net/rest/api/3/user?accountId=5b10ac8d82e05b22cc7d4ef5"
                  }
                ]
              }
            }
          },
          "400": { "description": "projectKeys 누락 / query·accountId 둘 다 없거나 둘 다 있음" },
          "401": { "description": "인증 정보 없음 또는 오류" },
          "404": { "description": "프로젝트를 찾을 수 없음" },
          "429": { "description": "Rate limit 초과 (사용자 검색 API 공용 한도)" }
        }
      }
    },
    "/rest/api/3/user/assignable/search": {
      "get": {
        "summary": "Find users assignable to issues",
        "description": "신규 이슈는 projectKeyOrId(project 파라미터)로, 기존 이슈는 issueKey/issueId로, 워크플로 전환 중에는 actionDescriptorId까지 함께 지정해 배정 가능한 사용자를 조회한다. sessionId를 사용하면 담당자가 확정될 때까지 동일 세션으로 유지할 수 있다.",
        "operationId": "findUsersAssignableToIssues",
        "tags": ["User search"],
        "x-priority": "high",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "사용자 속성 검색어. username/accountId 미지정 시 필수",
            "example": "john"
          },
          {
            "name": "sessionId",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "요청 세션 ID (담당자 확정 전까지 동일)"
          },
          {
            "name": "username",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "deprecated"
          },
          {
            "name": "accountId",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "정확히 일치하는 accountId. query 미지정 시 필수",
            "example": "5b10a2844c20165700ede21g"
          },
          {
            "name": "project",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "프로젝트 ID/키. issueKey/issueId 미지정 시 필수",
            "example": "PROJ"
          },
          {
            "name": "issueKey",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "이슈 키. issueId/project 미지정 시 필수",
            "example": "PROJ-123"
          },
          {
            "name": "issueId",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "이슈 ID",
            "example": "10001"
          },
          {
            "name": "startAt",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 0 },
            "description": "페이지 오프셋",
            "example": 0
          },
          {
            "name": "maxResults",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 50 },
            "description": "최대 반환 수",
            "example": 50
          },
          {
            "name": "actionDescriptorId",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" },
            "description": "전환(transition) ID",
            "example": 21
          },
          {
            "name": "recommend",
            "in": "query",
            "required": false,
            "schema": { "type": "boolean" },
            "description": "추천 사용자 우선 정렬 여부",
            "example": true
          },
          {
            "name": "accountType",
            "in": "query",
            "required": false,
            "schema": { "type": "array", "items": { "type": "string" } },
            "description": "계정 유형 필터"
          },
          {
            "name": "appType",
            "in": "query",
            "required": false,
            "schema": { "type": "array", "items": { "type": "string" } },
            "description": "앱 계정 유형 필터"
          }
        ],
        "responses": {
          "200": {
            "description": "요청 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accountId": { "type": "string", "description": "사용자 계정 ID" },
                    "accountType": { "type": "string" },
                    "active": { "type": "boolean" },
                    "applicationRoles": {
                      "type": "object",
                      "properties": {
                        "items": { "type": "array", "items": {} },
                        "size": { "type": "integer" }
                      }
                    },
                    "avatarUrls": {
                      "type": "object",
                      "properties": {
                        "16x16": { "type": "string" },
                        "24x24": { "type": "string" },
                        "32x32": { "type": "string" },
                        "48x48": { "type": "string" }
                      }
                    },
                    "displayName": { "type": "string", "description": "표시 이름" },
                    "emailAddress": { "type": "string", "description": "이메일" },
                    "groups": {
                      "type": "object",
                      "properties": {
                        "items": { "type": "array", "items": {} },
                        "size": { "type": "integer" }
                      }
                    },
                    "key": { "type": "string", "description": "deprecated" },
                    "name": { "type": "string", "description": "deprecated" },
                    "self": { "type": "string" },
                    "timeZone": { "type": "string", "description": "타임존" }
                  }
                },
                "example": {
                  "accountId": "5b10a2844c20165700ede21g",
                  "accountType": "atlassian",
                  "active": true,
                  "applicationRoles": { "items": [], "size": 1 },
                  "avatarUrls": {
                    "16x16": "https://avatar-management--avatars.server-location.prod.public.atl-paas.net/initials/MK-5.png?size=16&s=16",
                    "24x24": "https://avatar-management--avatars.server-location.prod.public.atl-paas.net/initials/MK-5.png?size=24&s=24",
                    "32x32": "https://avatar-management--avatars.server-location.prod.public.atl-paas.net/initials/MK-5.png?size=32&s=32",
                    "48x48": "https://avatar-management--avatars.server-location.prod.public.atl-paas.net/initials/MK-5.png?size=48&s=48"
                  },
                  "displayName": "Mia Krystof",
                  "emailAddress": "mia@example.com",
                  "groups": { "items": [], "size": 3 },
                  "key": "",
                  "name": "",
                  "self": "https://your-domain.atlassian.net/rest/api/3/user?accountId=5b10a2844c20165700ede21g",
                  "timeZone": "Australia/Sydney"
                }
              }
            }
          },
          "400": { "description": "issueKey/issueId/project 모두 없음, issueId 형식 오류, query/accountId 조합 오류" },
          "401": { "description": "인증 오류" },
          "404": { "description": "프로젝트, 이슈, 전환을 찾을 수 없음" },
          "429": { "description": "Rate limit 초과" }
        }
      }
    },
    "/rest/api/3/user/search": {
      "get": {
        "summary": "Find users",
        "description": "query, accountId, property 중 하나로 필터링하여 활성 사용자 목록을 반환하는 범용 사용자 검색 API다. 팀 생성 자동화에서 채널 멤버 후보를 찾거나 담당자 매핑을 만들 때 기본적으로 사용할 수 있다.",
        "operationId": "findUsers",
        "tags": ["User search"],
        "x-priority": "high",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "displayName, emailAddress 검색어. accountId/property 미지정 시 필수",
            "example": "john"
          },
          {
            "name": "username",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "deprecated"
          },
          {
            "name": "accountId",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "정확히 일치하는 accountId. query/property 미지정 시 필수",
            "example": "5b10a2844c20165700ede21g"
          },
          {
            "name": "startAt",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 0 },
            "description": "페이지 오프셋",
            "example": 0
          },
          {
            "name": "maxResults",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 50 },
            "description": "페이지당 최대 항목 수",
            "example": 50
          },
          {
            "name": "property",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "사용자 프로퍼티 검색 경로 쿼리. accountId/query 미지정 시 필수",
            "example": "thepropertykey.something.nested=1"
          }
        ],
        "responses": {
          "200": {
            "description": "요청 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "accountId": { "type": "string", "description": "계정 ID" },
                      "accountType": { "type": "string" },
                      "active": { "type": "boolean", "description": "활성 여부" },
                      "avatarUrls": {
                        "type": "object",
                        "properties": {
                          "16x16": { "type": "string" },
                          "24x24": { "type": "string" },
                          "32x32": { "type": "string" },
                          "48x48": { "type": "string" }
                        }
                      },
                      "displayName": { "type": "string", "description": "표시 이름" },
                      "key": { "type": "string", "description": "deprecated" },
                      "name": { "type": "string", "description": "deprecated" },
                      "self": { "type": "string" }
                    }
                  }
                },
                "example": [
                  {
                    "accountId": "5b10a2844c20165700ede21g",
                    "accountType": "atlassian",
                    "active": false,
                    "avatarUrls": {
                      "16x16": "https://avatar-management--avatars.server-location.prod.public.atl-paas.net/initials/MK-5.png?size=16&s=16",
                      "24x24": "https://avatar-management--avatars.server-location.prod.public.atl-paas.net/initials/MK-5.png?size=24&s=24",
                      "32x32": "https://avatar-management--avatars.server-location.prod.public.atl-paas.net/initials/MK-5.png?size=32&s=32",
                      "48x48": "https://avatar-management--avatars.server-location.prod.public.atl-paas.net/initials/MK-5.png?size=48&s=48"
                    },
                    "displayName": "Mia Krystof",
                    "key": "",
                    "name": "",
                    "self": "https://your-domain.atlassian.net/rest/api/3/user?accountId=5b10a2844c20165700ede21g"
                  }
                ]
              }
            }
          },
          "400": { "description": "accountId/query/property 모두 없음, query와 accountId 동시 지정, property 형식 오류" },
          "401": { "description": "인증 오류" },
          "429": { "description": "Rate limit 초과" }
        }
      }
    },
    "/rest/api/3/user/search/query": {
      "get": {
        "summary": "Find users by query",
        "description": "is assignee of PROJ, is watcher of (PROJ-1, PROJ-2), is commenter of (...) 등 구조화된 질의문으로 이슈와 사용자의 관계를 조회한다. 통합 알림·대시보드에서 특정 이슈의 담당자·워처·코멘트 작성자·투표자·전환 수행자를 한 번에 조회하는 데 유용하다. AND/OR로 복합 조건을 구성할 수 있고, 사용자 엔티티 프로퍼티 조건도 결합 가능하다.",
        "operationId": "findUsersByQuery",
        "tags": ["User search"],
        "x-priority": "high",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "구조화된 검색 쿼리",
            "example": "is watcher of (PROJ-1, PROJ-2)"
          },
          {
            "name": "startAt",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 0 },
            "description": "페이지 오프셋",
            "example": 0
          },
          {
            "name": "maxResults",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 50 },
            "description": "페이지당 최대 항목 수",
            "example": 50
          }
        ],
        "responses": {
          "200": {
            "description": "요청 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "isLast": { "type": "boolean", "description": "마지막 페이지 여부" },
                    "maxResults": { "type": "integer", "description": "반환 가능한 최대 항목 수" },
                    "nextPage": { "type": "string", "description": "다음 페이지 URL" },
                    "self": { "type": "string", "description": "현재 페이지 URL" },
                    "startAt": { "type": "integer", "description": "첫 항목 인덱스" },
                    "total": { "type": "integer", "description": "반환된 항목 수" },
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "accountId": { "type": "string", "description": "사용자 계정 ID" },
                          "accountType": { "type": "string", "enum": ["atlassian", "app", "customer", "unknown"] },
                          "active": { "type": "boolean", "description": "활성 여부" },
                          "appType": { "type": "string" },
                          "applicationRoles": { "type": "object", "description": "적용된 애플리케이션 역할" },
                          "avatarUrls": { "type": "object", "description": "아바타 URL" },
                          "displayName": { "type": "string", "description": "표시 이름" },
                          "emailAddress": { "type": "string", "description": "이메일" },
                          "expand": { "type": "string" },
                          "groups": { "type": "object", "description": "소속 그룹" },
                          "guest": { "type": "boolean" },
                          "key": { "type": "string", "description": "deprecated" },
                          "locale": { "type": "string" },
                          "name": { "type": "string", "description": "deprecated" },
                          "self": { "type": "string" },
                          "timeZone": { "type": "string", "description": "타임존" }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "isLast": true,
                  "maxResults": 50,
