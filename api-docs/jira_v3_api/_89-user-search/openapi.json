          },
          {
            "name": "exclude",
            "in": "query",
            "required": false,
            "schema": { "type": "array", "items": { "type": "string" } },
            "description": "deprecated. excludeAccountIds와 동시 사용 불가"
          },
          {
            "name": "excludeAccountIds",
            "in": "query",
            "required": false,
            "schema": { "type": "array", "items": { "type": "string" } },
            "description": "제외할 accountId 목록 (쉼표 또는 & 구분)",
            "example": "5b10a2844c20165700ede21g,5b10a0effa615349cb016cd8"
          },
          {
            "name": "avatarSize",
