    "/rest/api/3/user/permission/search": {
      "get": {
        "summary": "Find users with permissions",
        "description": "검색어(또는 accountId)와 permissions(쉼표 구분 권한 목록)를 조합하여, 지정한 프로젝트(projectKey) 또는 이슈(issueKey)에 대해 해당 권한을 가진 사용자만 걸러서 반환한다. 검색어가 없으면 해당 권한을 가진 모든 사용자를 반환한다.",
        "operationId": "findUsersWithPermissions",
        "tags": ["User search"],
        "x-priority": "medium",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "검색어. accountId 미지정 시 필수",
            "example": "john"
          },
          {
            "name": "username",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "deprecated"
          },
          {
            "name": "accountId",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "정확히 일치하는 accountId. query 미지정 시 필수",
            "example": "5b10a2844c20165700ede21g"
          },
          {
            "name": "permissions",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "쉼표로 구분된 권한 목록 (Get all permissions 참고 또는 deprecated 값: ASSIGNABLE_USER, BROWSE, CREATE_ISSUE 등)",
            "example": "BROWSE,CREATE_ISSUE"
          },
          {
            "name": "issueKey",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "이슈 키",
            "example": "PROJ-123"
          },
          {
            "name": "projectKey",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "프로젝트 키 (대소문자 구분)",
            "example": "PROJ"
          },
          {
            "name": "startAt",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 0 },
            "description": "페이지 오프셋",
            "example": 0
          },
          {
            "name": "maxResults",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 50 },
            "description": "페이지당 최대 항목 수",
            "example": 50
          }
        ],
        "responses": {
          "200": {
            "description": "요청 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "accountId": { "type": "string", "description": "계정 ID" },
                      "accountType": { "type": "string" },
                      "active": { "type": "boolean" },
                      "avatarUrls": {
                        "type": "object",
                        "properties": {
                          "16x16": { "type": "string" },
                          "24x24": { "type": "string" },
                          "32x32": { "type": "string" },
                          "48x48": { "type": "string" }
                        }
                      },
                      "displayName": { "type": "string", "description": "표시 이름" },
                      "key": { "type": "string" },
                      "name": { "type": "string" },
                      "self": { "type": "string" }
                    }
                  }
                },
                "example": [
                  {
                    "accountId": "5b10a2844c20165700ede21g",
                    "accountType": "atlassian",
                    "active": false,
                    "avatarUrls": {
                      "16x16": "https://avatar-management--avatars.server-location.prod.public.atl-paas.net/initials/MK-5.png?size=16&s=16",
                      "24x24": "https://avatar-management--avatars.server-location.prod.public.atl-paas.net/initials/MK-5.png?size=24&s=24",
                      "32x32": "https://avatar-management--avatars.server-location.prod.public.atl-paas.net/initials/MK-5.png?size=32&s=32",
                      "48x48": "https://avatar-management--avatars.server-location.prod.public.atl-paas.net/initials/MK-5.png?size=48&s=48"
                    },
                    "displayName": "Mia Krystof",
                    "key": "",
                    "name": "",
                    "self": "https://your-domain.atlassian.net/rest/api/3/user?accountId=5b10a2844c20165700ede21g"
                  }
                ]
              }
            }
          },
          "400": { "description": "issueKey/projectKey 누락, query/accountId 조합 오류, permissions 비어있거나 잘못된 값" },
          "401": { "description": "인증 오류" },
          "403": { "description": "필요 권한 없음 (프로젝트 관리자 권한 필요)" },
          "404": { "description": "이슈/프로젝트를 찾을 수 없음" },
          "429": { "description": "Rate limit 초과" }
        }
      }
    },
    "/rest/api/3/user/picker": {
      "get": {
        "summary": "Find users for picker",
        "description": "담당자 지정 등 사용자 선택 UI에서 자동완성 기능을 구현할 때 사용하는 API로, 일치 부분이 <strong> 태그로 감싸진 html 필드를 함께 반환한다. excludeAccountIds로 특정 사용자를 결과에서 제외할 수 있다.",
        "operationId": "findUsersForPicker",
        "tags": ["User search"],
        "x-priority": "medium",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "검색어",
            "example": "john"
          },
          {
            "name": "maxResults",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" },
            "description": "최대 반환 수 (전체 매칭 수는 total에 반환)",
            "example": 20
          },
          {
            "name": "showAvatar",
            "in": "query",
            "required": false,
