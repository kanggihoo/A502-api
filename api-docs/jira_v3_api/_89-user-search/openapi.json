                    "errorMessages": { "type": "array", "items": { "type": "string" } },
                    "errors": { "type": "object" },
                    "status": { "type": "integer" }
                  }
                },
                "example": {
                  "errorMessages": ["input parameter 'key' must be provided"],
                  "errors": {},
                  "status": 400
                }
              }
            }
          },
          "401": { "description": "인증 오류" },
          "403": { "description": "필요한 권한 없음" },
          "408": { "description": "검색 타임아웃" }
