{
  "openapi": "3.0.3",
  "info": {
    "title": "Jira API - __65-project-components",
    "version": "1.0.0",
    "description": "Jira 프로젝트 컴포넌트(Project Components)를 조회·생성·수정·삭제하고, 프로젝트별 컴포넌트 목록과 컴포넌트별 이슈 개수를 조회하는 API 모음. 전 엔드포인트가 프로젝트 관리자 수준 또는 그 이하 권한으로 호출 가능하다."
  },
  "servers": [
    {
      "url": "https://{siteName}.atlassian.net",
      "variables": {
        "siteName": {
          "default": "ssafy",
          "description": "Jira Cloud 사이트 이름 (예: ssafy.atlassian.net)"
        }
      }
    }
  ],
  "security": [
    { "basicAuth": [] },
    { "oauth2": ["read:jira-work", "write:jira-work"] }
  ],
  "tags": [
    { "name": "Project components", "description": "Jira 프로젝트 컴포넌트 생성/수정/조회/삭제 API" }
  ],
  "paths": {
    "/rest/api/3/component": {
      "post": {
        "summary": "Create component",
        "description": "팀 생성 자동화 시 프로젝트 구조(컴포넌트 단위)를 코드로 세팅할 때 핵심적으로 쓰인다. `project`(프로젝트 키)와 `name`은 필수이며, `assigneeType`으로 컴포넌트 생성 시 이슈의 기본 담당자 결정 방식을 지정할 수 있다. 프로젝트 관리자 권한으로 호출 가능하다.",
        "operationId": "createComponent",
        "tags": ["Project components"],
        "x-priority": "high",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "project"],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "컴포넌트 이름 (최대 255자, 프로젝트 내 유일)",
                    "example": "Component 1"
                  },
                  "project": {
                    "type": "string",
                    "description": "컴포넌트가 속할 프로젝트 키 (생성 후 변경 불가)",
                    "example": "HSP"
                  },
                  "description": {
                    "type": "string",
                    "description": "컴포넌트 설명",
                    "example": "This is a Jira component"
                  },
                  "assigneeType": {
                    "type": "string",
                    "enum": ["PROJECT_DEFAULT", "COMPONENT_LEAD", "PROJECT_LEAD", "UNASSIGNED"],
                    "description": "컴포넌트로 생성된 이슈의 명목상 담당자 결정 방식. 기본값 PROJECT_DEFAULT",
                    "example": "PROJECT_LEAD"
                  },
                  "leadAccountId": {
                    "type": "string",
                    "description": "컴포넌트 리드 사용자의 accountId",
                    "example": "5b10a2844c20165700ede21g"
                  },
                  "projectId": {
                    "type": "integer",
                    "description": "프로젝트 ID",
                    "example": 10000
                  }
                }
              },
              "example": {
                "name": "Component 1",
                "description": "This is a Jira component",
                "project": "HSP",
                "assigneeType": "PROJECT_LEAD",
                "leadAccountId": "5b10a2844c20165700ede21g"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created - 컴포넌트가 성공적으로 생성됨",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string", "description": "생성된 컴포넌트의 고유 ID" },
                    "name": { "type": "string", "description": "컴포넌트 이름" },
                    "description": { "type": "string", "description": "컴포넌트 설명" },
                    "project": { "type": "string", "description": "프로젝트 키" },
                    "projectId": { "type": "integer", "description": "프로젝트 ID" },
                    "assigneeType": { "type": "string", "description": "담당자 결정 방식" },
                    "isAssigneeTypeValid": { "type": "boolean", "description": "assigneeType에 해당하는 사용자가 실제로 존재하는지" },
                    "self": { "type": "string", "description": "컴포넌트 API URL" }
                  }
                },
                "example": {
                  "id": "10000",
                  "name": "Component 1",
                  "description": "This is a Jira component",
                  "project": "HSP",
                  "projectId": 10000,
                  "assigneeType": "PROJECT_LEAD",
                  "isAssigneeTypeValid": false,
                  "self": "https://your-domain.atlassian.net/rest/api/3/component/10000"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - 사용자를 찾을 수 없음 / name 미제공 / name이 255자 초과 / projectId 미제공 / assigneeType 값이 잘못됨",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "errorMessages": { "type": "array", "items": { "type": "string" } }, "errors": { "type": "object" } } },
                "example": { "errorMessages": [], "errors": { "name": "Component name is required" } }
              }
            }
          },
          "401": { "description": "Unauthorized - 인증 정보가 없거나 잘못됨" },
          "403": { "description": "Forbidden - 프로젝트 관리 권한 또는 Jira 관리 권한 없음" },
          "404": { "description": "Not Found - 프로젝트를 찾을 수 없거나 프로젝트를 볼 권한이 없음" }
        }
      },
      "get": {
        "summary": "Find components for projects",
        "description": "특정 프로젝트에 한정하지 않고 여러 프로젝트의 컴포넌트를 이름/설명 기준으로 검색할 때 사용하는 보조 조회 API다. 프로젝트별 컴포넌트 목록 조회(07, 08)와 달리 여러 프로젝트를 한 번에 다룰 수 있다. Compass 전역 컴포넌트가 포함될 경우 ari, metadata 필드가 추가로 반환된다.",
        "operationId": "findComponentsForProjects",
        "tags": ["Project components"],
        "x-priority": "medium",
        "parameters": [
          {
            "name": "projectIdsOrKeys",
            "in": "query",
            "required": false,
            "schema": { "type": "array", "items": { "type": "string" } },
            "description": "조회할 프로젝트 ID/키 목록(대소문자 구분)",
            "example": ["PR", "HSP"]
          },
          {
            "name": "startAt",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" },
            "description": "페이지 시작 오프셋",
            "example": 0
          },
          {
            "name": "maxResults",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" },
            "description": "페이지당 최대 항목 수",
            "example": 2
          },
          {
            "name": "orderBy",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["description", "name"] },
            "description": "정렬 기준: description, name",
            "example": "name"
          },
          {
            "name": "query",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "이름/설명에 대한 대소문자 무시 필터 문자열",
            "example": "backend"
          }
        ],
        "responses": {
          "200": {
            "description": "OK - 요청 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "isLast": { "type": "boolean", "description": "마지막 페이지 여부" },
                    "maxResults": { "type": "integer", "description": "페이지당 최대 항목 수" },
                    "startAt": { "type": "integer", "description": "시작 오프셋" },
                    "total": { "type": "integer", "description": "전체 항목 수" },
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string", "description": "컴포넌트 ID" },
                          "name": { "type": "string", "description": "컴포넌트 이름" },
                          "description": { "type": "string" },
                          "self": { "type": "string" },
                          "ari": { "type": "string", "description": "Compass 전역 컴포넌트의 ARI(전역 컴포넌트만)" },
                          "metadata": { "type": "object", "description": "Compass 전역 컴포넌트 메타데이터" }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "isLast": false,
                  "maxResults": 2,
                  "startAt": 0,
                  "total": 2,
                  "values": [
                    {
                      "description": "This is a component",
                      "id": "10000",
                      "name": "Component1",
                      "self": "http://www.example.com/jira/rest/api/2/component/10000"
                    },
                    {
                      "ari": "ari:cloud:graph::integration-context/ecda99d9-9b42-4bf7-8b4f-ecb5fcf5868c/component/10001",
                      "description": "This is a global component",
                      "id": "10001",
                      "metadata": { "key1": "value1", "key2": "value2" },
                      "name": "Component2",
                      "self": "http://www.example.com/jira/rest/api/2/component/10001"
                    }
                  ]
                }
              }
            }
          },
          "401": { "description": "Unauthorized - 인증 정보가 없거나 잘못됨" },
          "404": {
            "description": "Not Found - 프로젝트를 찾을 수 없거나 볼 권한 없음",
            "content": {
              "application/json": {
                "example": { "errorMessages": ["The project is not found."], "errors": {} }
              }
            }
          }
        }
      }
    },
    "/rest/api/3/component/{id}": {
      "put": {
        "summary": "Update component",
        "description": "요청에 포함된 필드는 모두 덮어써진다. leadAccountId를 빈 문자열(\"\")로 보내면 컴포넌트 리드가 제거된다. 프로젝트 운영 지원(컴포넌트 재구성, 리드 변경 등) 흐름에 직접 사용된다.",
        "operationId": "updateComponent",
        "tags": ["Project components"],
        "x-priority": "high",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "컴포넌트 ID",
            "example": "10000"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "description": "컴포넌트 이름 (최대 255자)", "example": "Component 1" },
                  "description": { "type": "string", "description": "컴포넌트 설명", "example": "This is a Jira component" },
                  "assigneeType": {
                    "type": "string",
                    "enum": ["PROJECT_DEFAULT", "COMPONENT_LEAD", "PROJECT_LEAD", "UNASSIGNED"],
                    "description": "담당자 결정 방식",
                    "example": "PROJECT_LEAD"
                  },
                  "leadAccountId": {
                    "type": "string",
                    "description": "컴포넌트 리드 accountId (빈 문자열이면 리드 제거)",
                    "example": "5b10ac8d82e05b22cc7d4ef5"
                  }
                }
              },
              "example": {
                "name": "Component 1",
                "description": "This is a Jira component",
                "assigneeType": "PROJECT_LEAD",
                "leadAccountId": "5b10a2844c20165700ede21g"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK - 컴포넌트가 성공적으로 수정됨",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string", "description": "컴포넌트 ID" },
                    "name": { "type": "string", "description": "컴포넌트 이름" },
                    "description": { "type": "string", "description": "컴포넌트 설명" },
                    "assigneeType": { "type": "string", "description": "담당자 결정 방식" },
                    "self": { "type": "string", "description": "컴포넌트 API URL" }
                  }
                },
                "example": {
                  "id": "10000",
                  "name": "Component 1",
                  "description": "This is a Jira component",
                  "assigneeType": "PROJECT_LEAD",
                  "self": "https://your-domain.atlassian.net/rest/api/3/component/10000"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - 사용자를 찾을 수 없음 / assigneeType 값이 잘못됨 / name이 255자 초과",
            "content": {
              "application/json": {
                "example": { "errorMessages": [], "errors": { "assigneeType": "Invalid assignee type" } }
              }
            }
          },
          "401": { "description": "Unauthorized - 인증 정보가 없거나 잘못됨" },
          "403": { "description": "Forbidden - 프로젝트 관리 권한 또는 Jira 관리 권한 없음" },
          "404": { "description": "Not Found - 컴포넌트를 찾을 수 없거나 프로젝트를 볼 권한이 없음" }
        }
      },
      "get": {
        "summary": "Get component",
        "description": "컴포넌트 ID로 단건 상세 정보(리드, 담당자 타입, 설명 등)를 조회한다. 대시보드에서 특정 컴포넌트를 드릴다운해서 보여줄 때 사용할 수 있다.",
        "operationId": "getComponent",
        "tags": ["Project components"],
        "x-priority": "medium",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "컴포넌트 ID",
            "example": "10000"
          }
        ],
        "responses": {
          "200": {
            "description": "OK - 요청 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string", "description": "컴포넌트 ID" },
                    "name": { "type": "string", "description": "컴포넌트 이름" },
                    "description": { "type": "string", "description": "컴포넌트 설명" },
                    "assigneeType": { "type": "string", "description": "담당자 결정 방식" },
                    "isAssigneeTypeValid": { "type": "boolean" },
                    "lead": {
                      "type": "object",
                      "description": "컴포넌트 리드 사용자 정보",
                      "properties": {
                        "accountId": { "type": "string" },
                        "displayName": { "type": "string" }
                      }
                    },
                    "project": { "type": "string", "description": "프로젝트 키" },
                    "projectId": { "type": "integer" },
                    "self": { "type": "string", "description": "컴포넌트 API URL" }
                  }
                },
                "example": {
                  "id": "10000",
                  "name": "Component 1",
                  "description": "This is a Jira component",
                  "assigneeType": "PROJECT_LEAD",
                  "isAssigneeTypeValid": false,
                  "lead": {
                    "accountId": "5b10a2844c20165700ede21g",
                    "displayName": "Mia Krystof"
                  },
                  "project": "HSP",
                  "projectId": 10000,
                  "self": "https://your-domain.atlassian.net/rest/api/3/component/10000"
                }
              }
            }
          },
          "401": { "description": "Unauthorized - 인증 정보가 없거나 잘못됨" },
          "404": {
            "description": "Not Found - 컴포넌트를 찾을 수 없거나 프로젝트를 볼 권한이 없음",
            "content": {
              "application/json": {
                "example": { "errorMessages": ["The component was not found."], "errors": {} }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete component",
        "description": "컴포넌트를 삭제한다. moveIssuesTo 쿼리 파라미터로 대체 컴포넌트를 지정하면 삭제되는 컴포넌트에 연결된 이슈들이 해당 컴포넌트로 이동한다. 프로젝트 구조 정리 등 부가적인 운영 작업에 쓰인다.",
        "operationId": "deleteComponent",
        "tags": ["Project components"],
        "x-priority": "medium",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "삭제할 컴포넌트의 ID",
            "example": "10000"
          },
          {
            "name": "moveIssuesTo",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "삭제된 컴포넌트를 대체할 컴포넌트 ID (기본값: null, 대체 없음)",
            "example": "10010"
          }
        ],
        "responses": {
          "204": {
            "description": "No Content - 삭제 성공 시 본문 없이 204를 반환"
          },
          "401": { "description": "Unauthorized - 인증 정보가 없거나 잘못됨" },
          "403": { "description": "Forbidden - 프로젝트 관리 권한 또는 Jira 관리 권한 없음" },
          "404": {
            "description": "Not Found - 컴포넌트를 찾을 수 없음 / 대체 컴포넌트를 찾을 수 없음 / 프로젝트를 볼 권한 없음",
            "content": {
              "application/json": {
                "example": { "errorMessages": ["The component was not found."], "errors": {} }
              }
            }
          }
        }
      }
    },
    "/rest/api/3/component/{id}/relatedIssueCounts": {
      "get": {
        "summary": "Get component issues count",
        "description": "컴포넌트별 이슈 개수를 대시보드 통계용으로 조회할 때 사용한다. 별도의 권한 요구사항이 없어 접근성이 높지만, 2024-06-15부터 OAuth 2.0 스코프가 변경될 예정이라는 지원 종료(Deprecation) 공지가 있다.",
        "operationId": "getComponentRelatedIssues",
        "tags": ["Project components"],
        "x-priority": "medium",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "컴포넌트 ID",
            "example": "10000"
          }
        ],
        "responses": {
          "200": {
            "description": "OK - 요청 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "issueCount": { "type": "integer", "description": "컴포넌트에 연결된 이슈 개수" },
                    "self": { "type": "string", "description": "컴포넌트 API URL" }
                  }
                },
                "example": {
                  "issueCount": 23,
                  "self": "https://your-domain.atlassian.net/rest/api/3/component/10000"
                }
              }
            }
          },
          "401": { "description": "Unauthorized - 인증 정보가 없거나 잘못됨" },
          "404": {
            "description": "Not Found - 컴포넌트를 찾을 수 없음",
            "content": {
              "application/json": {
                "example": { "errorMessages": ["The component was not found."], "errors": {} }
              }
            }
          }
        }
      }
    },
    "/rest/api/3/project/{projectIdOrKey}/component": {
      "get": {
        "summary": "Get project components paginated",
        "description": "통합 대시보드에서 프로젝트별 컴포넌트 목록(이슈 개수 포함)을 페이지네이션으로 가져올 때 사용한다. Compass 컴포넌트를 사용하는 프로젝트의 경우 연동된 Compass 컴포넌트 목록도 반환할 수 있다.",
        "operationId": "getProjectComponentsPaginated",
        "tags": ["Project components"],
        "x-priority": "high",
        "parameters": [
          {
            "name": "projectIdOrKey",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "프로젝트 ID 또는 키(대소문자 구분)",
            "example": "PR"
          },
          {
            "name": "startAt",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" },
            "description": "페이지 시작 오프셋",
            "example": 0
          },
          {
            "name": "maxResults",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" },
            "description": "페이지당 최대 항목 수",
            "example": 2
          },
          {
            "name": "orderBy",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["description", "issueCount", "lead", "name"] },
            "description": "정렬 기준: description, issueCount, lead, name",
            "example": "name"
          },
          {
            "name": "componentSource",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["jira", "compass", "auto"], "default": "jira" },
            "description": "컴포넌트 출처: jira(기본값), compass, auto",
            "example": "jira"
          },
          {
            "name": "query",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "이름/설명에 대한 대소문자 무시 필터 문자열",
            "example": "backend"
          }
        ],
        "responses": {
          "200": {
            "description": "OK - 요청 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "isLast": { "type": "boolean", "description": "마지막 페이지 여부" },
                    "maxResults": { "type": "integer", "description": "페이지당 최대 항목 수" },
                    "startAt": { "type": "integer", "description": "시작 오프셋" },
                    "total": { "type": "integer", "description": "전체 항목 수" },
                    "nextPage": { "type": "string", "description": "다음 페이지 URL" },
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string", "description": "컴포넌트 ID" },
                          "name": { "type": "string", "description": "컴포넌트 이름" },
                          "description": { "type": "string" },
                          "issueCount": { "type": "integer", "description": "컴포넌트에 연결된 이슈 수" },
                          "project": { "type": "string" },
                          "projectId": { "type": "integer" }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "isLast": false,
                  "maxResults": 2,
                  "startAt": 0,
                  "total": 7,
                  "nextPage": "https://your-domain.atlassian.net/rest/api/3/project/PR/component?startAt=2&maxResults=2",
                  "values": [
                    {
                      "id": "10000",
                      "name": "Component 1",
                      "description": "This is a Jira component",
                      "issueCount": 1,
                      "project": "HSP",
                      "projectId": 10000
                    }
                  ]
                }
              }
            }
          },
          "401": { "description": "Unauthorized - 인증 정보가 없거나 잘못됨" },
          "404": {
            "description": "Not Found - 프로젝트를 찾을 수 없거나 볼 권한 없음",
            "content": {
              "application/json": {
                "example": { "errorMessages": ["The project is not found."], "errors": {} }
              }
            }
          }
        }
      }
    },
    "/rest/api/3/project/{projectIdOrKey}/components": {
      "get": {
        "summary": "Get project components",
        "description": "대시보드나 자동화 스크립트에서 프로젝트의 전체 컴포넌트 목록을 한 번에 가져와야 할 때 간단히 사용할 수 있는 API다. Compass 컴포넌트를 사용하는 프로젝트에서는 페이지네이션된 Compass 컴포넌트 목록을 반환한다.",
        "operationId": "getProjectComponents",
        "tags": ["Project components"],
        "x-priority": "high",
        "parameters": [
          {
            "name": "projectIdOrKey",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "프로젝트 ID 또는 키(대소문자 구분)",
            "example": "PR"
          },
          {
            "name": "componentSource",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["jira", "compass", "auto"], "default": "jira" },
            "description": "컴포넌트 출처: jira(기본값), compass, auto",
            "example": "jira"
          }
        ],
        "responses": {
          "200": {
            "description": "OK - 요청 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "string", "description": "컴포넌트 ID" },
                      "name": { "type": "string", "description": "컴포넌트 이름" },
                      "description": { "type": "string", "description": "컴포넌트 설명" },
                      "project": { "type": "string", "description": "프로젝트 키" },
                      "projectId": { "type": "integer" },
                      "self": { "type": "string" }
                    }
                  }
                },
                "example": [
                  {
                    "id": "10000",
                    "name": "Component 1",
                    "description": "This is a Jira component",
                    "project": "HSP",
                    "projectId": 10000,
                    "self": "https://your-domain.atlassian.net/rest/api/3/component/10000"
                  }
                ]
              }
            }
          },
          "401": { "description": "Unauthorized - 인증 정보가 없거나 잘못됨" },
