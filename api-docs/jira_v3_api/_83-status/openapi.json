{
  "openapi": "3.0.3",
  "info": {
    "title": "Jira API - _83-status",
    "version": "1.0.0",
    "description": "Jira의 \"Status\"(이슈 상태) 정의를 검색, 조회, 생성, 수정, 삭제하고 특정 상태가 어느 이슈 타입/프로젝트/워크플로우에서 사용되고 있는지 조회하는 API 모음. 여기서 다루는 '상태'는 워크플로우 상 이슈가 전이되는 상태 값(To Do/In Progress/Done 등) 자체의 정의(카탈로그)를 의미하며, 개별 이슈의 상태 전이(transition) API와는 다르다."
  },
  "servers": [
    {
      "url": "https://{siteName}.atlassian.net",
      "variables": {
        "siteName": {
          "default": "ssafy",
          "description": "Jira Cloud 사이트 이름 (예: ssafy.atlassian.net)"
        }
      }
    }
  ],
  "security": [
    { "basicAuth": [] },
    { "oauth2": ["read:jira-work", "write:jira-work"] }
  ],
  "tags": [
    { "name": "Status", "description": "Jira 이슈 상태(status) 정의 조회/생성/수정/삭제 및 사용처 조회 API" }
  ],
  "paths": {
    "/rest/api/3/statuses": {
      "get": {
        "summary": "Bulk get statuses",
        "description": "지정한 상태 ID 목록에 해당하는 상태들의 이름, 설명, 범위(scope), 상태 카테고리를 반환한다. 대시보드나 자동화 로직에서 상태 ID를 사람이 읽을 수 있는 이름/카테고리로 변환하는 용도로 사용할 수 있다. 최소 1개, 최대 50개의 ID를 한 번에 조회할 수 있다.",
        "operationId": "bulkGetStatuses",
        "tags": ["Status"],
        "x-priority": "high",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "조회할 상태 ID 목록. 여러 개를 지정하려면 &로 구분한 리스트 형태로 전달 (최소 1개, 최대 50개)",
            "example": ["10000", "10001"],
            "schema": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1,
              "maxItems": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returned if the request is successful.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/JiraStatus" }
                },
                "example": [
                  {
                    "description": "The issue is resolved",
                    "id": "1000",
                    "name": "Finished",
                    "scope": { "project": { "id": "1" }, "type": "PROJECT" },
                    "statusCategory": "DONE"
                  }
                ]
              }
            }
          },
          "400": { "description": "요청이 유효하지 않음 (잘못된 ID 형식 등)" },
          "401": { "description": "인증 정보가 없거나 잘못됨, 또는 권한 부족" }
        }
      },
      "put": {
        "summary": "Bulk update statuses",
        "description": "기존 상태의 이름, 설명, 카테고리를 일괄 수정한다. 워크플로우에 사용 중인 상태 정의 자체를 바꾸는 관리자용 작업으로, 팀 생성 자동화나 알림/대시보드 같은 핵심 POC 흐름에서 직접 호출할 일은 적다.",
        "operationId": "bulkUpdateStatuses",
        "tags": ["Status"],
        "x-priority": "medium",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["statuses"],
                "properties": {
                  "statuses": {
                    "type": "array",
                    "description": "수정할 상태 목록",
                    "items": {
                      "type": "object",
                      "required": ["id", "name", "statusCategory"],
                      "properties": {
                        "id": { "type": "string", "description": "상태 ID" },
                        "name": { "type": "string", "description": "상태 이름" },
                        "description": { "type": "string", "description": "상태 설명" },
                        "statusCategory": {
                          "type": "string",
                          "enum": ["TODO", "IN_PROGRESS", "DONE"],
                          "description": "상태 카테고리"
                        }
                      }
                    }
                  }
                }
              },
              "example": {
                "statuses": [
                  {
                    "description": "The issue is resolved",
                    "id": "1000",
                    "name": "Finished",
                    "statusCategory": "DONE"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "204": { "description": "응답 본문 없음(성공 시)." },
          "400": {
            "description": "요청이 유효하지 않음 (예: 이름 길이 초과)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "errorMessages": ["The name is too long, maxSize=255"], "errors": {} }
              }
            }
          },
          "401": { "description": "인증 정보가 없거나 잘못됨, 또는 권한 부족" },
          "409": { "description": "다른 워크플로우 설정 변경 작업이 진행 중" }
        }
      },
      "post": {
        "summary": "Bulk create statuses",
        "description": "새 상태를 회사 관리(company-managed, GLOBAL) 또는 팀 관리(team-managed, PROJECT) 범위로 생성한다. 팀 생성 자동화 시 프로젝트 전용 커스텀 상태를 세팅하고 싶을 때 보조적으로 쓰일 수 있으나, 필수 핵심 흐름은 아니다.",
        "operationId": "bulkCreateStatuses",
        "tags": ["Status"],
        "x-priority": "medium",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["scope", "statuses"],
                "properties": {
                  "scope": {
                    "type": "object",
                    "required": ["type"],
                    "description": "상태의 적용 범위",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": ["PROJECT", "GLOBAL"],
                        "description": "GLOBAL은 회사 관리 프로젝트, PROJECT는 팀 관리 프로젝트용"
                      },
                      "project": {
                        "type": "object",
                        "required": ["id"],
                        "properties": {
                          "id": { "type": "string", "description": "프로젝트 ID" }
                        }
                      }
                    }
                  },
                  "statuses": {
                    "type": "array",
                    "description": "생성할 상태 목록",
                    "items": {
                      "type": "object",
                      "required": ["name", "statusCategory"],
                      "properties": {
                        "name": { "type": "string", "description": "상태 이름" },
                        "description": { "type": "string", "description": "상태 설명" },
                        "statusCategory": {
                          "type": "string",
                          "enum": ["TODO", "IN_PROGRESS", "DONE"],
                          "description": "상태 카테고리"
                        }
                      }
                    }
                  }
                }
              },
              "example": {
                "scope": {
                  "project": { "id": "1" },
                  "type": "PROJECT"
                },
                "statuses": [
                  {
                    "description": "The issue is resolved",
                    "name": "Finished",
                    "statusCategory": "DONE"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Returned if the request is successful.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/JiraStatus" }
                },
                "example": [
                  {
                    "description": "The issue is resolved",
                    "id": "1000",
                    "name": "Finished",
                    "scope": { "project": { "id": "1" }, "type": "PROJECT" },
                    "statusCategory": "DONE"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "요청이 유효하지 않음 (예: 이름 길이 초과)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "errorMessages": ["The name is too long, maxSize=255"], "errors": {} }
              }
            }
          },
          "401": { "description": "인증 정보가 없거나 잘못됨, 또는 권한 부족" },
          "409": { "description": "다른 워크플로우 설정 변경 작업이 진행 중" }
        }
      },
      "delete": {
        "summary": "Bulk delete Statuses",
        "description": "지정한 상태 ID들을 삭제한다. 상태 카탈로그를 정리하는 관리 작업으로, 워크플로우/이슈 타입에서 사용 중인 상태를 삭제하면 오류가 발생할 수 있어 신중하게 사용해야 한다.",
        "operationId": "bulkDeleteStatuses",
        "tags": ["Status"],
        "x-priority": "medium",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "삭제할 상태 ID 목록. 여러 개는 &로 구분 (최소 1개, 최대 50개)",
            "example": ["10000", "10001"],
            "schema": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1,
              "maxItems": 50
            }
          }
        ],
        "responses": {
          "204": { "description": "응답 본문 없음(성공 시)." },
          "400": {
            "description": "요청이 유효하지 않음",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "errorMessages": ["The name is too long, maxSize=255"], "errors": {} }
              }
            }
          },
          "401": { "description": "인증 정보가 없거나 잘못됨, 또는 권한 부족" }
        }
      }
    },
    "/rest/api/3/statuses/byNames": {
      "get": {
        "summary": "Bulk get statuses by name",
        "description": "상태 이름(예: \"Done\", \"In Progress\")을 기준으로 상태 정보를 조회한다. Browse projects 권한만으로도 호출 가능해 일반 프로젝트 멤버 수준 권한으로도 사용할 수 있는 조회 API다. 특정 프로젝트로 범위를 좁히려면 projectId를 지정하고, 생략하면 전역 상태까지 포함해 검색한다. 최소 1개, 최대 50개의 이름을 한 번에 조회할 수 있다.",
        "operationId": "bulkGetStatusesByName",
        "tags": ["Status"],
        "x-priority": "high",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": true,
            "description": "조회할 상태 이름 목록. 여러 개를 지정하려면 &로 구분 (최소 1개, 최대 50개)",
            "example": ["nameXX", "nameYY"],
            "schema": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1,
              "maxItems": 50
            }
          },
          {
            "name": "projectId",
            "in": "query",
            "required": false,
            "description": "상태가 속한 프로젝트 ID. 전역 상태를 조회하려면 생략(null)",
            "example": "10000",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Returned if the request is successful.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/JiraStatus" }
                },
                "example": [
                  {
                    "description": "The issue is resolved",
                    "id": "1000",
                    "name": "Finished",
                    "scope": { "project": { "id": "1" }, "type": "PROJECT" },
                    "statusCategory": "DONE"
                  }
                ]
              }
            }
          },
          "400": { "description": "요청이 유효하지 않음" },
          "401": { "description": "인증 정보가 없거나 잘못됨, 또는 권한 부족" }
        }
      }
    },
    "/rest/api/3/statuses/search": {
      "get": {
        "summary": "Search statuses paginated",
        "description": "검색어(searchString), 프로젝트(projectId), 상태 카테고리(statusCategory) 조건으로 상태 목록을 페이지 단위로 조회한다. 대시보드에서 프로젝트별 사용 가능한 상태 전체 목록을 보여주거나, 상태 카테고리(TODO/IN_PROGRESS/DONE)별 필터링 UI를 만들 때 활용할 수 있다.",
        "operationId": "searchStatusesPaginated",
        "tags": ["Status"],
        "x-priority": "high",
        "parameters": [
          {
            "name": "projectId",
            "in": "query",
            "required": false,
            "description": "상태가 속한 프로젝트 ID. 전역 상태는 null",
            "example": "10000",
            "schema": { "type": "string" }
          },
          {
            "name": "startAt",
            "in": "query",
            "required": false,
            "description": "페이지 오프셋(첫 결과의 인덱스)",
            "example": 0,
            "schema": { "type": "integer" }
          },
          {
            "name": "maxResults",
            "in": "query",
            "required": false,
            "description": "페이지당 최대 결과 수",
            "example": 2,
            "schema": { "type": "integer" }
          },
          {
            "name": "searchString",
            "in": "query",
            "required": false,
            "description": "상태 이름 매칭 검색어. 생략 시 검색 범위 내 전체 상태 반환",
            "example": "done",
            "schema": { "type": "string" }
          },
          {
            "name": "statusCategory",
            "in": "query",
            "required": false,
            "description": "필터링할 상태 카테고리",
            "example": "DONE",
            "schema": {
              "type": "string",
              "enum": ["TODO", "IN_PROGRESS", "DONE"]
            }
          },
          {
            "name": "includeGlobalStatuses",
            "in": "query",
            "required": false,
            "description": "전역 상태(scope=null)를 결과에 포함할지 여부. 프로젝트 범위 쿼리에서만 유효. 기본값 false",
            "example": true,
            "schema": { "type": "boolean", "default": false }
          }
        ],
        "responses": {
          "200": {
            "description": "Returned if the request is successful.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "isLast": { "type": "boolean", "description": "마지막 페이지 여부" },
                    "maxResults": { "type": "integer", "description": "페이지당 최대 결과 수" },
                    "startAt": { "type": "integer", "description": "현재 페이지 시작 인덱스" },
                    "total": { "type": "integer", "description": "전체 결과 수" },
                    "self": { "type": "string", "description": "현재 요청 URL" },
                    "nextPage": { "type": "string", "description": "다음 페이지 URL" },
                    "values": {
                      "type": "array",
                      "description": "상태 객체 목록",
                      "items": { "$ref": "#/components/schemas/JiraStatus" }
                    }
                  }
                },
                "example": {
                  "isLast": true,
                  "maxResults": 2,
                  "nextPage": "https://your-domain.atlassian.net/rest/api/3/statuses/search?startAt=2&maxResults=2",
                  "self": "https://your-domain.atlassian.net/rest/api/3/statuses/search?startAt=0&maxResults=2",
                  "startAt": 0,
                  "total": 5,
                  "values": [
                    {
                      "description": "The issue is resolved",
                      "id": "1000",
                      "name": "Finished",
                      "scope": { "project": { "id": "1" }, "type": "PROJECT" },
                      "statusCategory": "DONE"
                    }
                  ]
                }
              }
            }
          },
          "400": { "description": "요청이 유효하지 않음" },
          "401": { "description": "인증 정보가 없거나 잘못됨, 또는 권한 부족" }
        }
      }
    },
    "/rest/api/3/statuses/{statusId}/project/{projectId}/issueTypeUsages": {
      "get": {
        "summary": "Get issue type usages by status and project",
        "description": "주어진 상태가 특정 프로젝트 내 어느 이슈 타입에서 사용되고 있는지 확인한다. 상태 삭제/수정 전 영향 범위를 파악하는 용도로 유용하지만, 알림/대시보드/이슈 CRUD 같은 핵심 흐름에는 직접 관여하지 않는 보조 조회 API다.",
        "operationId": "getIssueTypeUsagesByStatusAndProject",
        "tags": ["Status"],
        "x-priority": "medium",
        "parameters": [
          {
            "name": "statusId",
            "in": "path",
            "required": true,
            "description": "이슈 타입 사용 현황을 조회할 상태 ID",
            "example": "1000",
            "schema": { "type": "string" }
          },
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "description": "이슈 타입 사용 현황을 조회할 프로젝트 ID",
            "example": "2000",
            "schema": { "type": "string" }
          },
          {
            "name": "nextPageToken",
            "in": "query",
            "required": false,
            "description": "페이지네이션 커서",
            "example": "eyJvIjoyfQ==",
            "schema": { "type": "string" }
          },
          {
            "name": "maxResults",
            "in": "query",
            "required": false,
            "description": "반환할 최대 결과 수 (1~200 사이 정수)",
            "example": 50,
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          }
        ],
        "responses": {
          "200": {
            "description": "Returned if the request is successful.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusId": { "type": "string", "description": "상태 ID" },
                    "projectId": { "type": "string", "description": "프로젝트 ID" },
                    "issueTypes": {
                      "type": "object",
                      "properties": {
                        "values": {
                          "type": "array",
                          "description": "해당 상태를 사용하는 이슈 타입 목록",
                          "items": {
                            "type": "object",
                            "properties": { "id": { "type": "string" } }
                          }
                        },
                        "nextPageToken": { "type": "string", "description": "다음 페이지 커서" }
                      }
                    }
                  }
                },
                "example": {
                  "issueTypes": {
                    "nextPageToken": "eyJvIjoyfQ==",
                    "values": [{ "id": "1000" }]
                  },
                  "projectId": "2000",
                  "statusId": "1000"
                }
              }
            }
          },
          "400": {
            "description": "nextPageToken 형식이 잘못됨 등 요청이 유효하지 않음",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "errorMessages": ["Invalid format of nextPageToken"], "errors": {} }
              }
            }
          },
          "401": { "description": "인증 정보가 없거나 잘못됨, 또는 권한 부족" },
          "404": { "description": "해당 ID의 상태가 존재하지 않음" }
        }
      }
    },
    "/rest/api/3/statuses/{statusId}/projectUsages": {
      "get": {
        "summary": "Get project usages by status",
