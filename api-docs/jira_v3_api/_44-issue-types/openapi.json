{
  "openapi": "3.0.3",
  "info": {
    "title": "Jira API - _44-issue-types",
    "version": "1.0.0",
    "description": "Jira의 이슈 타입(issue type)을 조회하고, 대체 가능한 이슈 타입을 확인하는 API 모음. 이슈 타입 생성/수정/삭제/아바타 업로드 등 사이트 전체 관리자(Administer Jira) 전용 기능은 제외하고, 프로젝트 관리자 수준 권한으로 호출 가능한 조회형 API만 포함한다."
  },
  "servers": [
    {
      "url": "https://{siteName}.atlassian.net",
      "variables": {
        "siteName": {
          "default": "ssafy",
          "description": "Jira Cloud 사이트 이름 (예: ssafy.atlassian.net)"
        }
      }
    }
  ],
  "security": [
    { "basicAuth": [] },
    { "oauth2": ["read:jira-work", "write:jira-work"] }
  ],
  "tags": [
    {
      "name": "Issue types",
      "description": "Jira 이슈 타입 조회 관련 API"
    }
  ],
  "paths": {
    "/rest/api/3/issuetype": {
      "get": {
        "summary": "사용자의 모든 이슈 타입 조회",
        "description": "현재 인증된 사용자(또는 익명 사용자)가 접근 가능한 모든 이슈 타입 목록을 반환한다. *Administer Jira* 전역 권한을 가진 사용자는 인스턴스의 모든 이슈 타입을 받고, 그렇지 않은 사용자는 자신이 *Browse projects* 권한을 가진 프로젝트들에 연결된 이슈 타입만 받는다. 익명 사용자는 익명 접근이 허용된 프로젝트 기준으로 결과가 제한되며, 인증 정보가 잘못된 경우 익명 사용자로 취급된다. 대시보드에서 이슈 타입 아이콘/이름을 표시하거나 필터링 옵션을 구성할 때 사용할 수 있다.",
        "operationId": "getAllIssueTypesForUser",
        "tags": ["Issue types"],
        "x-priority": "high",
        "security": [{ "basicAuth": [] }, { "oauth2": ["read:jira-work"] }, {}],
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": false,
            "schema": { "type": "string" },
            "description": "Basic 인증(이메일:API 토큰). 생략 시 익명 사용자로 처리",
            "example": "Basic base64(email:api_token)"
          }
        ],
        "responses": {
          "200": {
            "description": "요청 성공 (결과 범위는 권한에 따라 달라짐)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/IssueTypeDetails" }
                },
                "example": [
                  {
                    "avatarId": 1,
                    "description": "A task that needs to be done.",
                    "hierarchyLevel": 0,
                    "iconUrl": "https://your-domain.atlassian.net/secure/viewavatar?size=xsmall&avatarId=10299&avatarType=issuetype",
                    "id": "3",
                    "name": "Task",
                    "self": "https://your-domain.atlassian.net/rest/api/3/issueType/3",
                    "subtask": false
                  },
                  {
                    "avatarId": 10002,
                    "description": "A problem with the software.",
                    "entityId": "9d7dd6f7-e8b6-4247-954b-7b2c9b2a5ba2",
                    "hierarchyLevel": 0,
                    "iconUrl": "https://your-domain.atlassian.net/secure/viewavatar?size=xsmall&avatarId=10316&avatarType=issuetype",
                    "id": "1",
                    "name": "Bug",
                    "scope": { "project": { "id": "10000" }, "type": "PROJECT" },
                    "self": "https://your-domain.atlassian.net/rest/api/3/issueType/1",
                    "subtask": false
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/rest/api/3/issuetype/project": {
      "get": {
        "summary": "프로젝트의 이슈 타입 조회",
        "description": "프로젝트 ID를 기준으로 해당 프로젝트에서 사용 가능한 이슈 타입을 조회한다. `level` 파라미터로 서브태스크(-1), 기본(0), 에픽(1) 등 계층 레벨별 필터링이 가능하다. 팀 생성 자동화 시 프로젝트에 어떤 이슈 타입이 구성되어 있는지 확인하거나, 이슈 생성 폼의 이슈 타입 선택지를 구성할 때 사용한다.",
        "operationId": "getIssueTypesForProject",
        "tags": ["Issue types"],
        "x-priority": "high",
        "security": [{ "basicAuth": [] }, { "oauth2": ["read:jira-work"] }, {}],
        "parameters": [
          {
            "name": "projectId",
            "in": "query",
            "required": true,
            "schema": { "type": "integer" },
            "description": "프로젝트 ID",
            "example": 10000
          },
          {
            "name": "level",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" },
            "description": "필터링할 이슈 타입 계층 레벨 (-1: 서브태스크, 0: 기본, 1: 에픽)",
            "example": 0
          }
        ],
        "responses": {
          "200": {
            "description": "요청이 성공함",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/IssueTypeDetails" }
                },
                "example": [
                  {
                    "avatarId": 10002,
                    "description": "A problem with the software.",
                    "entityId": "9d7dd6f7-e8b6-4247-954b-7b2c9b2a5ba2",
                    "hierarchyLevel": 0,
                    "iconUrl": "https://your-domain.atlassian.net/secure/viewavatar?size=xsmall&avatarId=10316&avatarType=issuetype",
                    "id": "1",
                    "name": "Bug",
                    "scope": { "project": { "id": "10000" }, "type": "PROJECT" },
                    "self": "https://your-domain.atlassian.net/rest/api/3/issueType/1",
                    "subtask": false
                  },
                  {
                    "avatarId": 1,
                    "description": "A task that needs to be done.",
                    "hierarchyLevel": 0,
                    "iconUrl": "https://your-domain.atlassian.net/secure/viewavatar?size=xsmall&avatarId=10299&avatarType=issuetype",
                    "id": "3",
                    "name": "Task",
                    "scope": { "project": { "id": "10000" }, "type": "PROJECT" },
                    "self": "https://your-domain.atlassian.net/rest/api/3/issueType/3",
                    "subtask": false
                  }
                ]
              }
            }
          },
          "400": {
            "description": "요청이 유효하지 않음 (projectId 값 형식과 존재 여부 확인)"
          },
          "404": {
            "description": "프로젝트를 찾을 수 없거나, 사용자가 필요한 권한이 없음"
          }
        }
      }
    },
    "/rest/api/3/issuetype/{id}": {
      "get": {
        "summary": "이슈 타입 단건 조회",
        "description": "이슈 타입 ID로 이름, 설명, 아바타, 서브태스크 여부 등 상세 정보를 조회한다. 이슈 상세 화면이나 알림/대시보드에서 이슈 타입 ID만 알고 있을 때 이름·아이콘을 함께 표시하기 위해 사용한다.",
        "operationId": "getIssueType",
        "tags": ["Issue types"],
        "x-priority": "high",
        "security": [{ "basicAuth": [] }, { "oauth2": ["read:jira-work"] }, {}],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "이슈 타입 ID",
            "example": "3"
          }
        ],
        "responses": {
          "200": {
            "description": "요청이 성공함",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/IssueTypeDetails" },
                "example": {
                  "avatarId": 1,
                  "description": "A task that needs to be done.",
                  "hierarchyLevel": 0,
                  "iconUrl": "https://your-domain.atlassian.net/secure/viewavatar?size=xsmall&avatarId=10299&avatarType=issuetype",
                  "id": "3",
                  "name": "Task",
                  "self": "https://your-domain.atlassian.net/rest/api/3/issueType/3",
                  "subtask": false
                }
              }
            }
          },
          "400": {
            "description": "이슈 타입 ID가 유효하지 않음"
          },
          "404": {
            "description": "이슈 타입을 찾을 수 없거나 필요한 권한이 없음"
          }
        }
      }
    },
    "/rest/api/3/issuetype/{id}/alternatives": {
      "get": {
        "summary": "대체 가능한 이슈 타입 조회",
        "description": "같은 워크플로우 스킴, 필드 구성 스킴, 화면 스킴에 배정된 대체 가능 이슈 타입 목록을 조회한다. 이슈 타입 삭제 시 대체 이슈 타입을 선택해야 하는 흐름에서 후보 목록을 보여주기 위해 사용할 수 있으나, 이슈 타입 삭제 자체는 관리자 전용이라 이 API는 보조적인 조회 용도로만 활용된다.",
        "operationId": "getAlternativeIssueTypes",
        "tags": ["Issue types"],
        "x-priority": "medium",
        "security": [{ "basicAuth": [] }, { "oauth2": ["read:jira-work"] }, {}],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "이슈 타입 ID",
            "example": "3"
          }
        ],
        "responses": {
          "200": {
            "description": "요청이 성공함",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/IssueTypeDetails" }
                },
                "example": [
                  {
                    "avatarId": 1,
                    "description": "A task that needs to be done.",
                    "hierarchyLevel": 0,
                    "iconUrl": "https://your-domain.atlassian.net/secure/viewavatar?size=xsmall&avatarId=10299&avatarType=issuetype",
                    "id": "3",
                    "name": "Task",
                    "self": "https://your-domain.atlassian.net/rest/api/3/issueType/3",
                    "subtask": false
                  },
                  {
                    "avatarId": 10002,
                    "description": "A problem with the software.",
                    "entityId": "9d7dd6f7-e8b6-4247-954b-7b2c9b2a5ba2",
                    "hierarchyLevel": 0,
                    "iconUrl": "https://your-domain.atlassian.net/secure/viewavatar?size=xsmall&avatarId=10316&avatarType=issuetype",
                    "id": "1",
                    "name": "Bug",
                    "scope": { "project": { "id": "10000" }, "type": "PROJECT" },
                    "self": "https://your-domain.atlassian.net/rest/api/3/issueType/1",
                    "subtask": false
                  }
                ]
              }
            }
          },
          "404": {
            "description": "이슈 타입을 찾을 수 없거나 필요한 권한이 없음"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "Jira Cloud API 토큰 인증. username=계정 이메일, password=API token (https://id.atlassian.com/manage-profile/security/api-tokens 에서 발급)"
      },
      "oauth2": {
        "type": "oauth2",
        "description": "Jira Cloud OAuth 2.0 (3LO) Bearer 토큰 인증",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://auth.atlassian.com/authorize",
            "tokenUrl": "https://auth.atlassian.com/oauth/token",
            "scopes": {
              "read:jira-work": "Jira 작업 항목 읽기",
              "write:jira-work": "Jira 작업 항목 쓰기",
              "manage:jira-webhook": "Jira 웹훅 관리"
            }
          }
        }
      }
    },
    "schemas": {
      "IssueTypeDetails": {
        "type": "object",
        "properties": {
          "avatarId": {
            "type": "integer",
            "description": "이슈 타입 아바타의 ID"
          },
          "description": {
            "type": "string",
            "description": "이슈 타입 설명"
          },
          "entityId": {
            "type": "string",
            "description": "넥스트젠(팀 관리) 프로젝트용 고유 ID"
          },
          "hierarchyLevel": {
            "type": "integer",
            "description": "이슈 타입 계층 레벨"
          },
          "iconUrl": {
            "type": "string",
            "description": "이슈 타입 아바타 URL"
          },
          "id": {
            "type": "string",
            "description": "이슈 타입 ID"
          },
          "name": {
            "type": "string",
            "description": "이슈 타입 이름"
          },
          "scope": {
            "type": "object",
            "description": "넥스트젠 프로젝트 관련 이슈 타입 범위 정보",
            "properties": {
              "project": {
                "type": "object",
                "properties": {
                  "id": { "type": "string", "description": "프로젝트 ID" }
                }
              },
              "type": {
                "type": "string",
                "description": "범위 타입",
                "example": "PROJECT"
              }
            }
          },
          "self": {
            "type": "string",
            "description": "이슈 타입 상세 조회 URL"
          },
          "subtask": {
            "type": "boolean",
            "description": "서브태스크 생성용 이슈 타입 여부"
          }
        }
      }
    }
  }
}
