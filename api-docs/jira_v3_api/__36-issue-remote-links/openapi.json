{
  "openapi": "3.0.3",
  "info": {
    "title": "Jira API - __36-issue-remote-links",
    "version": "1.0.0",
    "description": "Jira 이슈와 외부 시스템(예: GitLab, Mattermost, 사내 지원 시스템 등)의 항목을 연결하는 '원격 이슈 링크(remote issue link)'를 조회·생성·수정·삭제하는 API 모음. 통합 알림/대시보드에서 이슈에 연결된 외부 링크를 보여주거나, 다른 도구의 리소스를 Jira 이슈에 자동으로 연결하는 데 사용할 수 있다."
  },
  "servers": [
    {
      "url": "https://{siteName}.atlassian.net",
      "variables": {
        "siteName": {
          "default": "ssafy",
          "description": "Jira Cloud 사이트 이름 (예: ssafy.atlassian.net)"
        }
      }
    }
  ],
  "security": [
    { "basicAuth": [] },
    { "oauth2": ["read:jira-work", "write:jira-work"] }
  ],
  "tags": [
    { "name": "Issue remote links", "description": "이슈와 외부 시스템 항목을 연결하는 원격 이슈 링크 관리 API" }
  ],
  "paths": {
    "/rest/api/3/issue/{issueIdOrKey}/remotelink": {
      "get": {
        "summary": "원격 이슈 링크 목록 조회",
        "description": "이슈에 연결된 원격 이슈 링크를 조회한다. `globalId`를 지정하면 해당 링크 하나만, 지정하지 않으면 전체 목록을 반환한다. 이슈 연결(issue linking) 기능이 활성화되어 있어야 호출할 수 있다. `globalId`에 URL 예약 문자가 포함된 경우 URL 인코딩하여 전달해야 한다(예: `system=http://www.mycompany.com/support&id=1` → `system%3Dhttp%3A%2F%2Fwww.mycompany.com%2Fsupport%26id%3D1`).",
        "operationId": "getRemoteIssueLinks",
        "tags": ["Issue remote links"],
        "x-priority": "high",
        "parameters": [
          {
            "name": "issueIdOrKey",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "이슈의 ID 또는 키",
            "example": "MKY-1"
          },
          {
            "name": "globalId",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "원격 이슈 링크의 글로벌 ID. URL 예약 문자가 포함된 경우 인코딩해서 전달해야 한다.",
            "example": "system=http://www.mycompany.com/support&id=1"
          }
        ],
        "responses": {
          "200": {
            "description": "globalId를 지정하면 단일 RemoteIssueLink 객체, 그렇지 않으면 RemoteIssueLink 배열을 반환한다.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "number", "description": "원격 이슈 링크 ID" },
                      "self": { "type": "string", "description": "링크의 REST API URL" },
                      "globalId": { "type": "string", "description": "원격 항목의 글로벌 ID" },
                      "application": {
                        "type": "object",
                        "description": "원격 애플리케이션 정보",
                        "properties": {
                          "name": { "type": "string" },
                          "type": { "type": "string" }
                        }
                      },
                      "relationship": { "type": "string", "description": "이슈와 링크 항목 간의 관계 설명" },
                      "object": {
                        "type": "object",
                        "description": "링크된 항목 상세 정보",
                        "properties": {
                          "title": { "type": "string" },
                          "url": { "type": "string" },
                          "summary": { "type": "string" },
                          "icon": {
                            "type": "object",
                            "properties": {
                              "title": { "type": "string" },
                              "url16x16": { "type": "string" }
                            }
                          },
                          "status": {
                            "type": "object",
                            "properties": {
                              "resolved": { "type": "boolean" },
                              "icon": {
                                "type": "object",
                                "properties": {
                                  "link": { "type": "string" },
                                  "title": { "type": "string" },
                                  "url16x16": { "type": "string" }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "example": [
                  {
                    "application": { "name": "My Acme Tracker", "type": "com.acme.tracker" },
                    "globalId": "system=http://www.mycompany.com/support&id=1",
                    "id": 10000,
                    "object": {
                      "icon": { "title": "Support Ticket", "url16x16": "http://www.mycompany.com/support/ticket.png" },
                      "status": {
                        "icon": { "link": "http://www.mycompany.com/support?id=1&details=closed", "title": "Case Closed", "url16x16": "http://www.mycompany.com/support/resolved.png" },
                        "resolved": true
                      },
                      "summary": "Customer support issue",
                      "title": "TSTSUP-111",
                      "url": "http://www.mycompany.com/support?id=1"
                    },
                    "relationship": "causes",
                    "self": "https://your-domain.atlassian.net/rest/api/issue/MKY-1/remotelink/10000"
                  }
                ]
              }
            }
          },
          "400": { "description": "요청이 유효하지 않음 (파라미터 형식, 특히 globalId 인코딩 확인)" },
          "401": { "description": "인증 정보가 없거나 잘못됨" },
          "403": { "description": "이슈 연결(issue linking) 기능이 비활성화됨" },
          "404": { "description": "이슈나 원격 링크를 찾을 수 없거나 조회 권한 없음" },
          "413": { "description": "이슈당 원격 링크 개수 제한 초과" }
        }
      },
      "post": {
        "summary": "원격 이슈 링크 생성/수정",
        "description": "이슈에 원격 이슈 링크를 생성하거나, 기존 globalId가 일치하는 링크가 있으면 갱신한다. globalId가 요청에 포함되어 있고 동일한 글로벌 ID를 가진 링크가 이미 존재하면 그 링크를 갱신하며, 이때 요청에 값이 없는 필드는 null로 설정된다. 존재하지 않으면 새 링크를 생성한다. 팀 생성 자동화나 통합 알림 흐름에서 GitLab MR, Mattermost 스레드 등 외부 리소스를 Jira 이슈에 자동으로 연결하는 핵심 API다.",
        "operationId": "createOrUpdateRemoteIssueLink",
        "tags": ["Issue remote links"],
        "x-priority": "high",
        "parameters": [
          {
            "name": "issueIdOrKey",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "이슈의 ID 또는 키",
            "example": "MKY-1"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "application": {
                    "type": "object",
                    "description": "원격 애플리케이션 상세 정보 (예: Trello)",
                    "properties": {
                      "name": { "type": "string" },
                      "type": { "type": "string" }
                    }
                  },
                  "globalId": {
                    "type": "string",
                    "description": "원격 시스템에서의 원격 항목 식별자. 설정 시 이후 Jira ID 대신 이 값으로 링크를 조회/수정/삭제 가능. 최대 255자.",
                    "maxLength": 255
                  },
                  "object": {
                    "type": "object",
                    "description": "링크된 항목의 상세 정보",
                    "properties": {
                      "title": { "type": "string" },
                      "url": { "type": "string" },
                      "summary": { "type": "string" },
                      "icon": {
                        "type": "object",
                        "properties": {
                          "title": { "type": "string" },
                          "url16x16": { "type": "string" }
                        }
                      },
                      "status": {
                        "type": "object",
                        "properties": {
                          "resolved": { "type": "boolean" },
                          "icon": {
                            "type": "object",
                            "properties": {
                              "link": { "type": "string" },
                              "title": { "type": "string" },
                              "url16x16": { "type": "string" }
                            }
                          }
                        }
                      }
                    }
                  },
                  "relationship": {
                    "type": "string",
                    "description": "이슈와 링크 항목 간의 관계 설명. 미지정 시 'links to' 사용"
                  }
                },
                "required": ["object"],
                "example": {
                  "application": { "name": "My Acme Tracker", "type": "com.acme.tracker" },
                  "globalId": "system=http://www.mycompany.com/support&id=1",
                  "object": {
                    "icon": { "title": "Support Ticket", "url16x16": "http://www.mycompany.com/support/ticket.png" },
                    "status": {
                      "icon": { "link": "http://www.mycompany.com/support?id=1&details=closed", "title": "Case Closed", "url16x16": "http://www.mycompany.com/support/resolved.png" },
                      "resolved": true
                    },
                    "summary": "Customer support issue",
                    "title": "TSTSUP-111",
                    "url": "http://www.mycompany.com/support?id=1"
                  },
                  "relationship": "causes"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "원격 이슈 링크가 갱신된 경우 반환",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "number", "description": "생성/갱신된 원격 이슈 링크 ID" },
                    "self": { "type": "string", "description": "링크의 REST API URL" }
                  }
                },
                "example": { "id": 10000, "self": "https://your-domain.atlassian.net/rest/api/issue/MKY-1/remotelink/10000" }
              }
            }
          },
          "201": {
            "description": "원격 이슈 링크가 생성된 경우 반환",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "number", "description": "생성/갱신된 원격 이슈 링크 ID" },
                    "self": { "type": "string", "description": "링크의 REST API URL" }
                  }
                },
                "example": { "id": 10000, "self": "https://your-domain.atlassian.net/rest/api/issue/MKY-1/remotelink/10000" }
              }
            }
          },
          "400": {
            "description": "요청 본문이 유효하지 않음 (예: 필수 필드 누락)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorMessages": { "type": "array", "items": { "type": "string" } },
                    "errors": { "type": "object" }
                  }
                },
                "example": { "errorMessages": [], "errors": { "title": "'title' is required." } }
              }
            }
          },
          "401": { "description": "인증 정보가 없거나 잘못됨" },
          "403": { "description": "이슈 연결 권한 없음" },
          "404": { "description": "이슈를 찾을 수 없거나 조회 권한 없음" }
        }
      },
      "delete": {
        "summary": "글로벌 ID로 원격 이슈 링크 삭제",
        "description": "원격 이슈 링크의 글로벌 ID를 이용해 이슈에서 해당 링크를 삭제한다. globalId 쿼리 파라미터로 삭제할 링크를 지정한다. 글로벌 ID에 URL 예약 문자가 포함되어 있으면 인코딩해서 전달해야 한다. 외부 시스템 리소스 ID로 링크를 관리하는 통합 시나리오(예: GitLab 이슈 삭제 시 연결된 Jira 링크 정리)에 유용하다.",
        "operationId": "deleteRemoteIssueLinkByGlobalId",
        "tags": ["Issue remote links"],
        "x-priority": "medium",
        "parameters": [
          {
            "name": "issueIdOrKey",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "이슈의 ID 또는 키",
            "example": "MKY-1"
          },
          {
            "name": "globalId",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "삭제할 원격 이슈 링크의 글로벌 ID",
            "example": "system=http://www.mycompany.com/support&id=1"
          }
        ],
        "responses": {
          "204": { "description": "요청이 성공하면 별도의 응답 본문 없이 204를 반환한다." },
          "400": { "description": "globalId가 제공되지 않음" },
          "401": { "description": "인증 정보가 없거나 잘못됨" },
          "403": { "description": "이슈 연결 권한 없음" },
          "404": { "description": "이슈나 원격 링크를 찾을 수 없거나 조회 권한 없음" }
        }
      }
    },
    "/rest/api/3/issue/{issueIdOrKey}/remotelink/{linkId}": {
      "get": {
        "summary": "ID로 원격 이슈 링크 조회",
        "description": "이슈에 연결된 특정 원격 이슈 링크를 ID로 조회한다. Jira 내부 링크 ID(linkId)를 이용해 단일 원격 이슈 링크의 상세 정보를 조회한다. 링크 목록 조회 후 특정 링크의 최신 상태만 확인하고 싶을 때 사용한다.",
        "operationId": "getRemoteIssueLinkById",
        "tags": ["Issue remote links"],
        "x-priority": "medium",
        "parameters": [
          {
            "name": "issueIdOrKey",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "이슈의 ID 또는 키",
            "example": "MKY-1"
          },
          {
            "name": "linkId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "원격 이슈 링크의 ID",
            "example": "10000"
          }
        ],
        "responses": {
          "200": {
            "description": "단일 RemoteIssueLink 객체를 반환한다.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "number", "description": "원격 이슈 링크 ID" },
                    "self": { "type": "string", "description": "링크의 REST API URL" },
                    "globalId": { "type": "string", "description": "원격 항목의 글로벌 ID" },
                    "application": {
                      "type": "object",
                      "description": "원격 애플리케이션 정보",
                      "properties": {
                        "name": { "type": "string" },
                        "type": { "type": "string" }
                      }
                    },
                    "relationship": { "type": "string", "description": "이슈와 링크 항목 간의 관계 설명" },
                    "object": {
                      "type": "object",
                      "description": "링크된 항목 상세 정보",
                      "properties": {
                        "title": { "type": "string" },
                        "url": { "type": "string" },
                        "summary": { "type": "string" },
                        "icon": {
                          "type": "object",
                          "properties": {
                            "title": { "type": "string" },
                            "url16x16": { "type": "string" }
                          }
                        },
                        "status": {
                          "type": "object",
                          "properties": {
                            "resolved": { "type": "boolean" },
                            "icon": {
                              "type": "object",
                              "properties": {
                                "link": { "type": "string" },
                                "title": { "type": "string" },
                                "url16x16": { "type": "string" }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "application": { "name": "My Acme Tracker", "type": "com.acme.tracker" },
                  "globalId": "system=http://www.mycompany.com/support&id=1",
                  "id": 10000,
                  "object": {
                    "icon": { "title": "Support Ticket", "url16x16": "http://www.mycompany.com/support/ticket.png" },
                    "status": {
                      "icon": { "link": "http://www.mycompany.com/support?id=1&details=closed", "title": "Case Closed", "url16x16": "http://www.mycompany.com/support/resolved.png" },
                      "resolved": true
                    },
                    "summary": "Customer support issue",
                    "title": "TSTSUP-111",
                    "url": "http://www.mycompany.com/support?id=1"
                  },
                  "relationship": "causes",
                  "self": "https://your-domain.atlassian.net/rest/api/issue/MKY-1/remotelink/10000"
                }
              }
            }
          },
          "400": { "description": "링크 ID가 유효하지 않거나 해당 이슈에 속하지 않음" },
          "401": { "description": "인증 정보가 없거나 잘못됨" },
          "403": { "description": "이슈 연결 기능이 비활성화됨" },
          "404": { "description": "이슈나 원격 링크를 찾을 수 없거나 조회 권한 없음" }
        }
      },
      "put": {
        "summary": "ID로 원격 이슈 링크 수정",
        "description": "Jira 내부 링크 ID를 이용해 특정 원격 이슈 링크를 수정한다. globalId 대신 Jira 내부 linkId를 식별자로 사용해 원격 이슈 링크를 갱신한다. 요청에 값이 없는 필드는 null로 설정되므로 전체 필드를 다시 보내야 한다.",
        "operationId": "updateRemoteIssueLinkById",
        "tags": ["Issue remote links"],
        "x-priority": "medium",
        "parameters": [
          {
            "name": "issueIdOrKey",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "이슈의 ID 또는 키",
            "example": "MKY-1"
          },
          {
            "name": "linkId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "원격 이슈 링크의 ID",
            "example": "10000"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "application": {
                    "type": "object",
                    "description": "원격 애플리케이션 상세 정보",
                    "properties": {
                      "name": { "type": "string" },
                      "type": { "type": "string" }
                    }
                  },
                  "globalId": {
                    "type": "string",
                    "description": "원격 시스템에서의 원격 항목 식별자. 최대 255자.",
                    "maxLength": 255
                  },
                  "object": {
                    "type": "object",
                    "description": "링크된 항목의 상세 정보",
                    "properties": {
                      "title": { "type": "string" },
                      "url": { "type": "string" },
                      "summary": { "type": "string" },
                      "icon": {
                        "type": "object",
                        "properties": {
                          "title": { "type": "string" },
                          "url16x16": { "type": "string" }
                        }
                      },
                      "status": {
                        "type": "object",
                        "properties": {
                          "resolved": { "type": "boolean" },
                          "icon": {
                            "type": "object",
                            "properties": {
                              "link": { "type": "string" },
                              "title": { "type": "string" },
                              "url16x16": { "type": "string" }
                            }
                          }
                        }
                      }
                    }
                  },
                  "relationship": {
                    "type": "string",
                    "description": "이슈와 링크 항목 간의 관계 설명"
                  }
                },
                "required": ["object"],
                "example": {
                  "application": { "name": "My Acme Tracker", "type": "com.acme.tracker" },
                  "globalId": "system=http://www.mycompany.com/support&id=1",
                  "object": {
                    "icon": { "title": "Support Ticket", "url16x16": "http://www.mycompany.com/support/ticket.png" },
                    "status": {
                      "icon": { "link": "http://www.mycompany.com/support?id=1&details=closed", "title": "Case Closed", "url16x16": "http://www.mycompany.com/support/resolved.png" },
                      "resolved": true
                    },
