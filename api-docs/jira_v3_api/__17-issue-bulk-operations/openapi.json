        }
      }
    },
    "/rest/api/3/bulk/queue/{taskId}": {
      "get": {
        "summary": "Get bulk issue operation progress",
        "description": "다른 벌크 작업 API 호출 시 반환받은 taskId로 해당 작업의 진행률과 완료 여부, 처리 결과를 조회한다. 작업 생성일로부터 최대 14일간 진행 상태를 조회할 수 있다. 통합 대시보드에서 벌크 작업의 완료 여부를 폴링하거나 알림을 보낼 때 핵심적으로 사용된다.",
        "operationId": "getBulkIssueOperationProgress",
        "tags": ["Issue bulk operations"],
        "x-priority": "high",
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {"type": "string"},
            "description": "조회할 작업의 ID",
            "example": "10000"
          }
        ],
        "responses": {
          "200": {
            "description": "요청이 성공적으로 처리되어 작업 진행 상태를 반환함. RUNNING 상태와 COMPLETE 상태에서 응답 필드 구성이 다르다.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "taskId": {"type": "string", "description": "작업 ID"},
                    "status": {"type": "string", "description": "작업 상태(RUNNING, COMPLETE 등)"},
                    "progressPercent": {"type": "number", "description": "진행률(%)"},
                    "submittedBy": {
                      "type": "object",
                      "properties": {
                        "accountId": {"type": "string", "description": "작업을 요청한 사용자 accountId"}
                      }
                    },
                    "created": {"type": "number", "description": "작업 생성 시각(epoch ms)"},
                    "started": {"type": "number", "description": "작업 시작 시각(epoch ms)"},
                    "updated": {"type": "number", "description": "최종 갱신 시각(epoch ms)"},
                    "processedAccessibleIssues": {
                      "type": "array",
                      "items": {"type": "number"},
                      "description": "처리된 접근 가능 이슈 ID 목록(완료 시)"
                    },
                    "invalidOrInaccessibleIssueCount": {"type": "number", "description": "유효하지 않거나 접근 불가능한 이슈 수(완료 시)"},
                    "totalIssueCount": {"type": "number", "description": "전체 대상 이슈 수(완료 시)"}
                  }
                },
                "examples": {
                  "running": {
                    "summary": "작업이 진행 중인 경우",
                    "value": {
                      "taskId": "10779",
                      "status": "RUNNING",
                      "progressPercent": 65,
                      "submittedBy": {"accountId": "5b10a2844c20165700ede21g"},
                      "created": 1690180055963,
                      "started": 1690180056206,
                      "updated": 1690180058290
                    }
                  },
                  "complete": {
                    "summary": "작업이 완료된 경우",
                    "value": {
                      "created": 1704110400000,
                      "invalidOrInaccessibleIssueCount": 0,
                      "processedAccessibleIssues": [10001, 10002],
                      "progressPercent": 100,
                      "started": 1704110460000,
                      "status": "COMPLETE",
                      "submittedBy": {"accountId": "5b10a2844c20165700ede21g"},
                      "taskId": "10000",
                      "totalIssueCount": 2,
                      "updated": 1704110520000
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "요청이 유효하지 않음(예: 해당 taskId가 벌크 작업 태스크가 아님)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorMessages": {"type": "array", "items": {"type": "string"}},
                    "errors": {"type": "object"},
                    "httpStatusCode": {
                      "type": "object",
                      "properties": {
                        "empty": {"type": "boolean"},
                        "present": {"type": "boolean"}
                      }
                    }
                  }
                },
                "example": {"errorMessages": ["The task associated with this taskId is not a bulk operation task"], "errors": {}, "httpStatusCode": {"empty": false, "present": true}}
              }
            }
          },
          "401": {"description": "인증 자격 증명이 잘못되었거나 없음"}
        }
      }
    },
