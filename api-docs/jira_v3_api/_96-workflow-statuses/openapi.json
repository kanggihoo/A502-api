{
  "openapi": "3.0.3",
  "info": {
    "title": "Jira API - _96-workflow-statuses",
    "version": "1.0.0",
    "description": "Jira 이슈 워크플로우 상태(status) 조회 API. 활성 워크플로우에 연결된 전체 상태 목록을 가져오거나, 특정 상태 하나를 ID/이름으로 조회할 수 있다."
  },
  "servers": [
    {
      "url": "https://{siteName}.atlassian.net",
      "variables": {
        "siteName": {
          "default": "ssafy",
          "description": "Jira Cloud 사이트 이름 (예: ssafy.atlassian.net)"
        }
      }
    }
  ],
  "security": [
    { "basicAuth": [] },
    { "oauth2": ["read:jira-work", "write:jira-work"] }
  ],
  "tags": [
    { "name": "Workflow statuses", "description": "Jira 이슈 워크플로우 상태(status) 조회 API" }
  ],
  "paths": {
    "/rest/api/3/status": {
      "get": {
        "summary": "Get all statuses",
        "description": "이 API는 Jira 사이트 내 활성 워크플로우에 포함된 모든 상태의 목록을 반환한다. 각 상태는 이름, 설명, 아이콘 URL, 그리고 상태 카테고리(진행 전/진행 중/완료) 정보를 포함한다. 통합 대시보드에서 이슈 상태 값을 사람이 읽을 수 있는 이름이나 색상(카테고리)으로 매핑해 보여줄 때 기준 데이터로 활용할 수 있다. 익명 접근이 가능하며, *Browse projects* 프로젝트 권한이 필요하다.",
        "operationId": "getAllStatuses",
        "tags": ["Workflow statuses"],
        "x-priority": "high",
        "security": [
          { "basicAuth": [] },
          { "oauth2": ["read:jira-work"] },
          {}
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "요청이 성공한 경우 반환된다.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "string", "description": "상태 ID" },
                      "name": { "type": "string", "description": "상태 이름" },
                      "description": { "type": "string", "description": "상태 설명" },
                      "iconUrl": { "type": "string", "description": "상태 아이콘 URL" },
                      "self": { "type": "string", "description": "상태 리소스 URL" },
                      "statusCategory": {
                        "type": "object",
                        "description": "상태 카테고리 정보 (색상, 이름, key 등)",
                        "properties": {
                          "id": { "type": "integer", "description": "상태 카테고리 ID" },
                          "key": { "type": "string", "description": "상태 카테고리 key" },
                          "colorName": { "type": "string", "description": "상태 카테고리 색상 이름" },
                          "name": { "type": "string", "description": "상태 카테고리 이름" },
                          "self": { "type": "string", "description": "상태 카테고리 리소스 URL" }
                        }
                      }
                    }
                  }
                },
                "example": [
                  {
                    "description": "The issue is currently being worked on.",
                    "iconUrl": "https://your-domain.atlassian.net/images/icons/progress.gif",
                    "id": "10000",
                    "name": "In Progress",
                    "self": "https://your-domain.atlassian.net/rest/api/3/status/10000",
                    "statusCategory": {
                      "colorName": "yellow",
                      "id": 1,
                      "key": "in-flight",
                      "name": "In Progress",
                      "self": "https://your-domain.atlassian.net/rest/api/3/statuscategory/1"
                    }
                  },
                  {
                    "description": "The issue is closed.",
                    "iconUrl": "https://your-domain.atlassian.net/images/icons/closed.gif",
                    "id": "5",
                    "name": "Closed",
                    "self": "https://your-domain.atlassian.net/rest/api/3/status/5",
                    "statusCategory": {
                      "colorName": "green",
                      "id": 9,
                      "key": "completed",
                      "self": "https://your-domain.atlassian.net/rest/api/3/statuscategory/9"
                    }
                  }
                ]
              }
            }
          },
          "401": {
            "description": "인증 정보가 없거나 올바르지 않은 경우 반환된다."
          }
        }
      }
    },
    "/rest/api/3/status/{idOrName}": {
      "get": {
        "summary": "Get status",
        "description": "지정한 ID 또는 이름에 해당하는 상태 하나를 반환한다. 해당 상태는 활성 워크플로우에 연결되어 있어야 조회된다. 이름이 여러 상태에서 중복 사용되는 경우 가장 먼저 찾은 상태만 반환되므로, 이름보다는 ID로 조회하는 것이 더 정확하다. 익명 접근이 가능하며, *Browse projects* 프로젝트 권한이 필요하다.",
        "operationId": "getStatus",
        "tags": ["Workflow statuses"],
        "x-priority": "medium",
        "security": [
          { "basicAuth": [] },
          { "oauth2": ["read:jira-work"] },
          {}
        ],
        "parameters": [
          {
            "name": "idOrName",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "조회할 상태의 ID 또는 이름",
            "example": "10000"
          }
        ],
        "responses": {
          "200": {
            "description": "요청이 성공한 경우 반환된다.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string", "description": "상태 ID" },
                    "name": { "type": "string", "description": "상태 이름" },
                    "description": { "type": "string", "description": "상태 설명" },
                    "iconUrl": { "type": "string", "description": "상태 아이콘 URL" },
                    "self": { "type": "string", "description": "상태 리소스 URL" },
                    "statusCategory": {
                      "type": "object",
                      "description": "상태 카테고리 정보 (색상, 이름, key 등)",
                      "properties": {
                        "id": { "type": "integer", "description": "상태 카테고리 ID" },
                        "key": { "type": "string", "description": "상태 카테고리 key" },
                        "colorName": { "type": "string", "description": "상태 카테고리 색상 이름" },
                        "name": { "type": "string", "description": "상태 카테고리 이름" },
                        "self": { "type": "string", "description": "상태 카테고리 리소스 URL" }
                      }
                    }
                  }
                },
                "example": {
                  "description": "The issue is currently being worked on.",
                  "iconUrl": "https://your-domain.atlassian.net/images/icons/progress.gif",
                  "id": "10000",
                  "name": "In Progress",
                  "self": "https://your-domain.atlassian.net/rest/api/3/status/10000",
                  "statusCategory": {
                    "colorName": "yellow",
                    "id": 1,
                    "key": "in-flight",
                    "name": "In Progress",
                    "self": "https://your-domain.atlassian.net/rest/api/3/statuscategory/1"
                  }
                }
              }
            }
          },
          "401": {
            "description": "인증 정보가 없거나 올바르지 않은 경우 반환된다."
          },
          "404": {
            "description": "상태를 찾을 수 없거나, 상태가 워크플로우에 연결되지 않았거나, 사용자가 필요한 권한을 가지고 있지 않은 경우 반환된다."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "Jira Cloud API 토큰 인증. username=계정 이메일, password=API token (https://id.atlassian.com/manage-profile/security/api-tokens 에서 발급)"
      },
      "oauth2": {
        "type": "oauth2",
        "description": "Jira Cloud OAuth 2.0 (3LO) Bearer 토큰 인증",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://auth.atlassian.com/authorize",
            "tokenUrl": "https://auth.atlassian.com/oauth/token",
            "scopes": {
              "read:jira-work": "Jira 작업 항목 읽기",
              "write:jira-work": "Jira 작업 항목 쓰기",
              "manage:jira-webhook": "Jira 웹훅 관리"
            }
          }
        }
      }
    }
  }
}
