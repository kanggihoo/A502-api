{
  "openapi": "3.0.3",
  "info": {
    "title": "Jira API - _57-myself",
    "version": "1.0.0",
    "description": "현재 인증된 사용자(Myself) 본인의 기본 정보, 환경설정(preferences), 로케일(locale)을 조회·생성·수정·삭제(기본값 복원)하는 API 모음."
  },
  "servers": [
    {
      "url": "https://{siteName}.atlassian.net",
      "variables": {
        "siteName": {
          "default": "ssafy",
          "description": "Jira Cloud 사이트 이름 (예: ssafy.atlassian.net)"
        }
      }
    }
  ],
  "security": [
    { "basicAuth": [] },
    { "oauth2": ["read:jira-work", "write:jira-work"] }
  ],
  "paths": {
    "/rest/api/3/myself": {
      "get": {
        "summary": "Get current user",
        "description": "현재 로그인한 사용자의 accountId, 표시 이름, 이메일, 아바타, 그룹, 애플리케이션 역할, 타임존 등 상세 정보를 반환한다. `expand` 쿼리 파라미터로 그룹 및 애플리케이션 역할 정보를 추가로 포함할 수 있다. 팀 생성 자동화 시 현재 사용자의 accountId를 식별하거나, 통합 대시보드에서 로그인 사용자 정보를 표시할 때 핵심적으로 사용된다.",
        "operationId": "getCurrentUser",
        "tags": ["Myself"],
        "x-priority": "high",
        "parameters": [
          {
            "name": "expand",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "쉼표로 구분된 목록. `groups`(중첩 그룹 포함 모든 그룹), `applicationRoles`(할당된 애플리케이션 역할) 확장 가능",
            "example": "groups,applicationRoles"
          }
        ],
        "responses": {
          "200": {
            "description": "요청이 성공한 경우 반환됨",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accountId": { "type": "string", "description": "사용자 계정 ID" },
                    "accountType": { "type": "string", "description": "계정 타입" },
                    "active": { "type": "boolean", "description": "활성 사용자 여부" },
                    "applicationRoles": {
                      "type": "object",
                      "description": "할당된 애플리케이션 역할 목록(size 포함)",
                      "properties": {
                        "items": { "type": "array", "items": {} },
                        "size": { "type": "integer" }
                      }
                    },
                    "avatarUrls": {
                      "type": "object",
                      "description": "크기별 아바타 URL",
                      "properties": {
                        "16x16": { "type": "string" },
                        "24x24": { "type": "string" },
                        "32x32": { "type": "string" },
                        "48x48": { "type": "string" }
                      }
                    },
                    "displayName": { "type": "string", "description": "표시 이름" },
                    "emailAddress": { "type": "string", "description": "이메일 주소" },
                    "groups": {
                      "type": "object",
                      "description": "소속 그룹 목록(size 포함)",
                      "properties": {
                        "items": { "type": "array", "items": {} },
                        "size": { "type": "integer" }
                      }
                    },
                    "key": { "type": "string", "description": "레거시 사용자 키(더 이상 사용되지 않음)" },
                    "name": { "type": "string", "description": "레거시 사용자 이름(더 이상 사용되지 않음)" },
                    "self": { "type": "string", "description": "사용자 리소스 URL" },
                    "timeZone": { "type": "string", "description": "타임존" }
                  }
                },
                "example": {
                  "accountId": "5b10a2844c20165700ede21g",
                  "accountType": "atlassian",
                  "active": true,
                  "applicationRoles": { "items": [], "size": 1 },
                  "avatarUrls": {
                    "16x16": "https://avatar-management--avatars.server-location.prod.public.atl-paas.net/initials/MK-5.png?size=16&s=16",
                    "24x24": "https://avatar-management--avatars.server-location.prod.public.atl-paas.net/initials/MK-5.png?size=24&s=24",
                    "32x32": "https://avatar-management--avatars.server-location.prod.public.atl-paas.net/initials/MK-5.png?size=32&s=32",
                    "48x48": "https://avatar-management--avatars.server-location.prod.public.atl-paas.net/initials/MK-5.png?size=48&s=48"
                  },
                  "displayName": "Mia Krystof",
                  "emailAddress": "mia@example.com",
                  "groups": { "items": [], "size": 3 },
                  "key": "",
                  "name": "",
                  "self": "https://your-domain.atlassian.net/rest/api/3/user?accountId=5b10a2844c20165700ede21g",
                  "timeZone": "Australia/Sydney"
                }
              }
            }
          },
          "401": {
            "description": "인증 정보가 없거나 잘못됨"
          }
        }
      }
    },
    "/rest/api/3/mypreferences": {
      "get": {
        "summary": "Get preference",
        "description": "`key` 쿼리 파라미터로 지정한 사용자 preference의 값을 문자열로 반환한다. `jira.user.locale`, `jira.user.timezone` 키는 더 이상 사용되지 않으며(deprecated), `user.notifications.*` 계열 키도 2024-07-15부로 알림 동작에 영향을 주지 않게 될 예정이다. 타임존/로케일 관리는 사용자 관리 REST API의 프로필 수정 엔드포인트 사용을 권장한다.",
        "operationId": "getPreference",
        "tags": ["Myself"],
        "x-priority": "medium",
        "parameters": [
          {
            "name": "key",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "조회할 preference의 키",
            "example": "user.notifications.mimetype"
          }
        ],
        "responses": {
          "200": {
            "description": "요청이 성공한 경우 반환됨",
            "content": {
              "application/json": {
                "schema": { "type": "string", "description": "preference의 값" },
                "example": "html"
              }
            }
          },
          "401": {
            "description": "인증 정보가 없거나 잘못됨"
          },
          "404": {
            "description": "`key`가 제공되지 않았거나 존재하지 않음"
          }
        }
      },
      "put": {
        "summary": "Set preference",
        "description": "일반 텍스트 문자열 값으로 preference를 생성하거나 갱신한다. 임의의 preference는 최대 255자까지 값으로 가질 수 있다. `user.notifications.mimetype`, `user.default.share.private`, `user.keyboard.shortcuts.disabled`, `user.autowatch.disabled`, `user.notifiy.own.changes` 등 시스템 정의 키를 설정할 수 있으며, 로케일/타임존 관련 키는 deprecated 상태이다.",
        "operationId": "setPreference",
        "tags": ["Myself"],
        "x-priority": "medium",
        "parameters": [
          {
            "name": "key",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "maxLength": 255 },
            "description": "설정할 preference의 키 (최대 255자)",
            "example": "user.notifications.mimetype"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "string",
                "maxLength": 255,
                "description": "preference 값(plain text). 임의의 값은 최대 255자까지 가능."
              },
              "example": "false"
            }
          }
        },
        "responses": {
          "204": {
            "description": "요청이 성공한 경우 반환됨(응답 본문 없음)"
          },
          "401": {
            "description": "인증 정보가 없거나 잘못됨"
          },
          "404": {
            "description": "`key` 또는 값이 제공되지 않았거나 유효하지 않음"
          }
        }
      },
      "delete": {
        "summary": "Delete preference",
        "description": "지정한 키의 preference를 삭제하여 시스템 정의 설정값의 경우 기본값으로 복원한다. 로케일/타임존 관련 키는 deprecated 상태이며 사용자 관리 REST API 사용을 권장한다.",
        "operationId": "deletePreference",
        "tags": ["Myself"],
        "x-priority": "medium",
        "parameters": [
          {
            "name": "key",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "삭제할 preference의 키",
            "example": "user.notifications.mimetype"
          }
        ],
        "responses": {
          "204": {
            "description": "요청이 성공한 경우 반환됨(응답 본문 없음)"
          },
          "401": {
            "description": "인증 정보가 없거나 잘못됨"
          },
          "404": {
            "description": "`key`가 제공되지 않았거나 존재하지 않음"
          }
        }
      }
    },
    "/rest/api/3/mypreferences/locale": {
      "get": {
        "summary": "Get locale",
        "description": "사용자의 언어 preference를 반환한다. 사용자가 언어 설정을 하지 않았거나(기본값) 익명으로 접근한 경우, `Accept-Language` 헤더로 감지된 브라우저 로케일을 반환하며, 이 로케일이 Jira에서 지원되지 않으면 사이트 기본 로케일을 반환한다. 익명 접근이 가능한 몇 안 되는 엔드포인트 중 하나다.",
        "operationId": "getLocale",
        "tags": ["Myself"],
        "x-priority": "medium",
        "security": [
          { "basicAuth": [] },
          { "oauth2": ["read:jira-work"] },
          {}
        ],
        "responses": {
          "200": {
            "description": "요청이 성공한 경우 반환됨",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "locale": { "type": "string", "description": "로케일 코드" }
                  }
                },
                "example": { "locale": "en_US" }
              }
            }
          },
          "401": {
            "description": "인증 정보가 있으나 잘못됨"
          }
        }
      },
      "put": {
        "summary": "Set locale",
        "description": "사용자의 로케일을 설정한다. Jira 인스턴스가 지원하는 로케일이어야 한다. 이 엔드포인트는 Deprecated 상태이며, 사용자 관리 REST API의 프로필 수정 엔드포인트 사용이 권장된다.",
        "operationId": "setLocale",
        "tags": ["Myself"],
        "x-priority": "medium",
        "deprecated": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "locale": {
                    "type": "string",
                    "description": "로케일 코드. ISO 639 언어코드 + `_` + ISO 3166 국가코드 형식(예: en_US). 생성 시 필수."
                  }
                },
                "required": ["locale"]
              },
              "example": { "locale": "en_US" }
            }
          }
        },
        "responses": {
          "204": {
            "description": "요청이 성공한 경우 반환됨(응답 본문 없음)"
          },
          "400": {
            "description": "요청이 유효하지 않음"
          },
          "401": {
            "description": "인증 정보가 없거나 잘못됨"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "Jira Cloud API 토큰 인증. username=계정 이메일, password=API token (https://id.atlassian.com/manage-profile/security/api-tokens 에서 발급)"
      },
      "oauth2": {
        "type": "oauth2",
        "description": "Jira Cloud OAuth 2.0 (3LO) Bearer 토큰 인증",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://auth.atlassian.com/authorize",
            "tokenUrl": "https://auth.atlassian.com/oauth/token",
            "scopes": {
              "read:jira-work": "Jira 작업 항목 읽기",
              "write:jira-work": "Jira 작업 항목 쓰기",
              "manage:jira-webhook": "Jira 웹훅 관리"
            }
          }
        }
      }
    }
  }
}
