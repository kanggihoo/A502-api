{
  "openapi": "3.0.3",
  "info": {
    "title": "Jira API - _76-projects",
    "version": "1.0.0",
    "description": "Jira 프로젝트(project) 자체를 대상으로 조회/생성/수정/삭제하고, 프로젝트의 상태 목록·이슈 유형 계층·알림 스킴 등 부가 정보를 가져오는 API 모음. SSAFY 팀 프로젝트 통합 워크스페이스 POC용으로 정리됨."
  },
  "servers": [
    {
      "url": "https://{siteName}.atlassian.net",
      "variables": {
        "siteName": {
          "default": "ssafy",
          "description": "Jira Cloud 사이트 이름 (예: ssafy.atlassian.net)"
        }
      }
    }
  ],
  "security": [
    {
      "basicAuth": []
    },
    {
      "oauth2": [
        "read:jira-work",
        "write:jira-work"
      ]
    }
  ],
  "tags": [
    {
      "name": "Projects",
      "description": "Jira 프로젝트 조회/생성/수정/삭제 및 부가 정보 API"
    }
  ],
  "paths": {
    "/rest/api/3/project": {
      "post": {
        "summary": "Create project",
        "description": "팀 생성 자동화 흐름에서 SSAFY 팀별 Jira 프로젝트를 자동 생성하는 데 핵심적으로 쓰이는 API다. projectTypeKey와 projectTemplateKey 조합으로 소프트웨어/비즈니스/서비스데스크 등 프로젝트 유형을 지정하며, key, name, leadAccountId(또는 lead) 중 하나는 필수다. 스킴(필드, 이슈타입, 워크플로우, 알림, 권한 등)을 직접 지정하려면 projectTemplateKey와 함께 사용할 수 없다.",
        "operationId": "createProject",
        "tags": [
          "Projects"
        ],
        "x-priority": "high",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "description": "프로젝트 키(고유). 대문자로 시작, 대문자/숫자 조합, 최대 10자",
                    "example": "EX"
                  },
                  "name": {
                    "type": "string",
                    "description": "프로젝트 이름",
                    "example": "Example"
                  },
                  "projectTypeKey": {
                    "type": "string",
                    "enum": [
                      "software",
                      "service_desk",
                      "business",
                      "customer_service"
                    ],
                    "description": "프로젝트 유형",
                    "example": "software"
                  },
                  "projectTemplateKey": {
                    "type": "string",
                    "description": "프로젝트 템플릿. projectTypeKey와 일치해야 함",
                    "example": "com.pyxis.greenhopper.jira:gh-simplified-agility-scrum"
                  },
                  "leadAccountId": {
                    "type": "string",
                    "description": "프로젝트 리더의 계정 ID. lead와 동시 사용 불가",
                    "example": "5b10a2844c20165700ede21g"
                  },
                  "lead": {
                    "type": "string",
                    "description": "Deprecated. 프로젝트 리더 사용자명(구버전). leadAccountId와 동시 사용 불가"
                  },
                  "description": {
                    "type": "string",
                    "description": "프로젝트 설명",
                    "example": "SSAFY 팀 프로젝트"
                  },
                  "assigneeType": {
                    "type": "string",
                    "enum": [
                      "PROJECT_LEAD",
                      "UNASSIGNED"
                    ],
                    "description": "기본 담당자",
                    "example": "PROJECT_LEAD"
                  },
                  "avatarId": {
                    "type": "integer",
                    "description": "아바타 ID",
                    "example": 10011
                  },
                  "categoryId": {
                    "type": "integer",
                    "description": "프로젝트 카테고리 ID",
                    "example": 10000
                  },
                  "notificationScheme": {
                    "type": "integer",
                    "description": "알림 스킴 ID",
                    "example": 10100
                  },
                  "permissionScheme": {
                    "type": "integer",
                    "description": "권한 스킴 ID",
                    "example": 10001
                  },
                  "issueSecurityScheme": {
                    "type": "integer",
                    "description": "이슈 보안 스킴 ID"
                  },
                  "fieldConfigurationScheme": {
                    "type": "integer",
                    "description": "Deprecated. 필드 구성 스킴 ID. projectTemplateKey와 동시 지정 불가"
                  },
                  "fieldScheme": {
                    "type": "integer",
                    "description": "필드 스킴 ID. projectTemplateKey와 동시 지정 불가"
                  },
                  "issueTypeScheme": {
                    "type": "integer",
                    "description": "이슈 타입 스킴 ID. projectTemplateKey와 동시 지정 불가"
                  },
                  "issueTypeScreenScheme": {
                    "type": "integer",
                    "description": "이슈 타입 화면 스킴 ID. projectTemplateKey와 동시 지정 불가"
                  },
                  "workflowScheme": {
                    "type": "integer",
                    "description": "워크플로우 스킴 ID. projectTemplateKey와 동시 지정 불가"
                  },
                  "url": {
                    "type": "string",
                    "description": "프로젝트 관련 문서 링크",
                    "example": "https://www.example.com"
                  }
                },
                "required": [
                  "key",
                  "name"
                ],
                "example": {
                  "key": "EX",
                  "name": "Example",
                  "projectTypeKey": "software",
                  "projectTemplateKey": "com.pyxis.greenhopper.jira:gh-simplified-agility-scrum",
                  "leadAccountId": "5b10a2844c20165700ede21g",
                  "description": "SSAFY 팀 프로젝트"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Returned if the project is created.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "description": "생성된 프로젝트 ID"
                    },
                    "key": {
                      "type": "string",
                      "description": "프로젝트 키"
                    },
                    "self": {
                      "type": "string",
                      "description": "프로젝트 리소스 URL"
                    }
                  }
                },
                "example": {
                  "id": 10010,
                  "key": "EX",
                  "self": "https://your-domain.atlassian.net/jira/rest/api/3/project/10042"
                }
              }
            }
          },
          "400": {
            "description": "요청 본문이 유효하지 않아 프로젝트 생성 실패"
          },
          "401": {
            "description": "인증 정보 누락/오류"
          },
          "403": {
            "description": "프로젝트 생성 권한 없음(Administer Jira 필요)"
          }
        }
      },
      "get": {
        "summary": "Get all projects",
        "description": "페이지네이션과 검색을 지원하지 않는 구버전 API로, Atlassian은 Get projects paginated 사용을 권장한다. 소규모 프로젝트 목록을 빠르게 확인하는 보조 용도로만 유용하다. (Deprecated)",
        "operationId": "getAllProjects",
        "tags": [
          "Projects"
        ],
        "x-priority": "medium",
        "deprecated": true,
        "parameters": [
          {
            "name": "expand",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "추가 정보 확장(description,issueTypes,lead,projectKeys)",
            "example": "lead"
          },
          {
            "name": "recent",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "최근 접근한 프로젝트 수(최대 20)",
            "example": 10
          },
          {
            "name": "properties",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "반환할 프로젝트 속성 목록"
          }
        ],
        "responses": {
          "200": {
            "description": "Returned if the request is successful.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "example": [
                  {
                    "id": "10000",
                    "key": "EX",
                    "name": "Example",
                    "self": "https://your-domain.atlassian.net/rest/api/3/project/EX"
                  }
                ]
              }
            }
          },
          "401": {
            "description": "인증 정보 누락/오류"
          }
        }
      }
    },
    "/rest/api/3/project/search": {
      "get": {
        "summary": "Get projects paginated",
        "description": "01-get-all-projects의 대체 API로, 대시보드에서 팀이 접근 가능한 프로젝트 목록을 검색어(query)나 키/ID, 상태(live/archived/deleted)로 필터링하여 보여줄 때 사용한다. 정렬(orderBy)과 확장 옵션(expand)을 지원해 목록 화면 구성에 적합하다.",
        "operationId": "getProjectsPaginated",
        "tags": [
          "Projects"
        ],
        "x-priority": "high",
        "parameters": [
          {
            "name": "startAt",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "페이지 오프셋",
            "example": 0
          },
          {
            "name": "maxResults",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "페이지당 최대 개수(최대 100)",
            "example": 50
          },
          {
            "name": "orderBy",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "category",
                "issueCount",
                "key",
                "lastIssueUpdatedTime",
                "name",
                "owner",
                "archivedDate",
                "deletedDate"
              ]
            },
            "description": "정렬 기준",
            "example": "name"
          },
          {
            "name": "id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "description": "프로젝트 ID 필터(최대 50개)",
            "example": [
              10000,
              10001
            ]
          },
          {
            "name": "keys",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "프로젝트 키 필터(최대 50개)",
            "example": [
              "PA",
              "PB"
            ]
          },
          {
            "name": "query",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "키/이름 부분 일치 검색어(대소문자 무시)",
            "example": "SSAFY"
          },
          {
            "name": "typeKey",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "business",
                "service_desk",
                "software"
              ]
            },
            "description": "프로젝트 유형",
            "example": "software"
          },
          {
            "name": "categoryId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "프로젝트 카테고리 ID",
            "example": 10000
          },
          {
            "name": "action",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "view",
                "browse",
                "edit",
                "create"
              ]
            },
            "description": "사용자가 가능한 작업 기준 필터",
            "example": "view"
          },
          {
            "name": "expand",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "추가 정보 확장(description,projectKeys,lead,issueTypes,url,insight)",
            "example": "description,lead"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "live",
                  "archived",
                  "deleted"
                ]
              }
            },
            "description": "프로젝트 상태 필터",
            "example": [
              "live"
            ]
          },
          {
            "name": "properties",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "반환할 프로젝트 속성 목록"
          },
          {
            "name": "propertyQuery",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "속성 값 검색 쿼리"
          }
        ],
        "responses": {
          "200": {
            "description": "Returned if the request is successful.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "isLast": {
                      "type": "boolean",
                      "description": "마지막 페이지 여부"
                    },
                    "maxResults": {
                      "type": "integer",
                      "description": "페이지당 결과 수"
                    },
                    "startAt": {
                      "type": "integer",
                      "description": "시작 오프셋"
                    },
                    "total": {
                      "type": "integer",
                      "description": "전체 결과 수"
                    },
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "description": "프로젝트 객체 배열"
                    }
                  }
                },
                "example": {
                  "isLast": false,
                  "maxResults": 2,
                  "startAt": 0,
                  "total": 7,
                  "nextPage": "https://your-domain.atlassian.net/rest/api/3/project/search?startAt=2&maxResults=2",
                  "self": "https://your-domain.atlassian.net/rest/api/3/project/search?startAt=0&maxResults=2",
                  "values": [
                    {
                      "id": "10000",
                      "key": "EX",
                      "name": "Example",
                      "self": "https://your-domain.atlassian.net/rest/api/3/project/EX",
                      "simplified": false,
                      "style": "classic",
                      "projectCategory": {
                        "id": "10000",
                        "name": "FIRST",
                        "description": "First Project Category",
                        "self": "https://your-domain.atlassian.net/rest/api/3/projectCategory/10000"
                      },
                      "insight": {
                        "totalIssueCount": 100,
                        "lastIssueUpdateTime": "2021-04-22T05:37:05.000+0000"
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "요청 파라미터가 유효하지 않음"
          },
          "401": {
            "description": "인증 정보 누락/오류"
          },
          "404": {
            "description": "검색 조건에 맞는 프로젝트 없음"
          }
        }
      }
    },
    "/rest/api/3/project/{projectIdOrKey}": {
      "get": {
        "summary": "Get project",
        "description": "프로젝트 대시보드나 알림에서 특정 프로젝트의 이름, 리드, 컴포넌트, 이슈 타입, 카테고리 등 상세 정보를 원문 링크와 함께 보여줄 때 사용하는 핵심 조회 API다. expand로 설명, 이슈타입, 리드, 이슈타입 계층 등을 추가로 포함시킬 수 있다.",
        "operationId": "getProject",
        "tags": [
          "Projects"
        ],
        "x-priority": "high",
        "parameters": [
          {
            "name": "projectIdOrKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "프로젝트 ID 또는 키(대소문자 구분)",
            "example": "EX"
          },
          {
            "name": "expand",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "추가 정보 확장(description,issueTypes,lead,projectKeys,issueTypeHierarchy)",
            "example": "lead,issueTypes"
          },
          {
            "name": "properties",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "반환할 프로젝트 속성 목록"
          }
        ],
        "responses": {
          "200": {
            "description": "Returned if successful.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "프로젝트 ID"
                    },
                    "key": {
                      "type": "string",
                      "description": "프로젝트 키"
                    },
                    "name": {
                      "type": "string",
                      "description": "프로젝트 이름"
                    },
                    "description": {
                      "type": "string",
                      "description": "프로젝트 설명"
                    },
                    "lead": {
                      "type": "object",
                      "description": "프로젝트 리드 정보"
                    },
                    "issueTypes": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "description": "프로젝트에 연결된 이슈 타입 목록"
                    },
                    "self": {
                      "type": "string",
                      "description": "리소스 URL"
                    }
                  }
                },
                "example": {
                  "id": "10000",
                  "key": "EX",
                  "name": "Example",
                  "description": "This project was created as an example for REST.",
                  "lead": {
                    "accountId": "5b10a2844c20165700ede21g",
                    "displayName": "Mia Krystof"
                  },
                  "self": "https://your-domain.atlassian.net/rest/api/3/project/EX"
                }
              }
            }
          },
          "401": {
            "description": "인증 정보 누락/오류"
          },
          "404": {
            "description": "프로젝트가 없거나 조회 권한 없음"
          }
        }
      },
      "put": {
        "summary": "Update project",
        "description": "팀 생성 자동화 이후 프로젝트 설정(리드 변경, 설명 갱신, 알림/권한 스킴 연결 등)을 자동으로 조정하는 데 사용한다. 요청 본문의 모든 필드는 선택 사항이며, 포함되지 않은 스킴은 변경되지 않는다.",
        "operationId": "updateProject",
        "tags": [
          "Projects"
        ],
        "x-priority": "high",
        "parameters": [
          {
            "name": "projectIdOrKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "프로젝트 ID 또는 키(대소문자 구분)",
            "example": "EX"
          },
          {
            "name": "expand",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "추가 정보 확장(description,issueTypes,lead,projectKeys)",
            "example": "lead"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "프로젝트 이름",
                    "example": "Example"
                  },
                  "description": {
                    "type": "string",
                    "description": "프로젝트 설명",
                    "example": "업데이트된 설명"
                  },
                  "leadAccountId": {
                    "type": "string",
                    "description": "프로젝트 리드 계정 ID. lead와 동시 사용 불가",
                    "example": "5b10a2844c20165700ede21g"
                  },
                  "key": {
                    "type": "string",
