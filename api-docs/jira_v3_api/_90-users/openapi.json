    "/rest/api/3/user/email": {
      "get": {
        "summary": "Get user email",
        "description": "사용자의 프로필 공개 설정과 무관하게 이메일 주소를 조회한다. 일반 사용자 컨텍스트로는 호출이 제한되며(401), 승인된 Connect 앱 또는 asApp() 방식의 Forge 앱에서만 사용 가능하다. 통합 알림에서 이메일로 사용자에게 알림을 보내야 할 때 유용하지만 접근 제약이 있어 핵심 흐름으로 보기는 어렵다.",
        "operationId": "getUserEmail",
        "tags": ["Users"],
        "x-priority": "medium",
        "parameters": [
          {
            "name": "accountId",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "사용자 계정 ID",
            "example": "5b10ac8d82e05b22cc7d4ef5"
          }
        ],
        "responses": {
          "200": {
            "description": "요청 성공",
            "content": {
              "application/json": {
                "schema": { "type": "string", "description": "사용자 이메일 주소" },
                "example": "name@example.com"
              }
            }
          },
          "400": { "description": "호출 앱이 이 API 사용을 승인받지 않음" },
          "401": { "description": "인증 정보 누락/오류 (일반 사용자가 접근 시도하는 경우 포함)" },
          "404": { "description": "해당 accountId의 사용자가 존재하지 않음" },
          "503": { "description": "API가 현재 비활성화됨" }
        }
      }
    },
    "/rest/api/3/user/email/bulk": {
      "get": {
        "summary": "Get user email bulk",
        "description": "여러 사용자의 이메일 주소를 프로필 공개 설정과 무관하게 한 번에 조회한다. Get user email의 벌크 버전으로, 여러 accountId에 대한 이메일을 한 번에 조회한다. 동일하게 앱 승인/인증 방식 제약이 있다.",
        "operationId": "getUserEmailBulk",
        "tags": ["Users"],
        "x-priority": "medium",
        "parameters": [
          {
            "name": "accountId",
            "in": "query",
            "required": true,
            "schema": { "type": "array", "items": { "type": "string" } },
            "description": "이메일을 조회할 사용자들의 accountId 목록",
            "example": ["5b10ac8d82e05b22cc7d4ef5"]
          }
        ],
        "responses": {
          "200": {
            "description": "요청 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accountId": { "type": "string", "description": "사용자 accountId" },
                    "email": { "type": "string", "description": "사용자 이메일" }
                  }
                },
                "example": {
                  "accountId": "5b10ac8d82e05b22cc7d4ef5",
                  "email": "name@example.com"
                }
              }
            }
          },
          "400": { "description": "호출 앱이 이 API 사용을 승인받지 않음" },
          "401": { "description": "인증 정보 누락/오류 (일반 사용자가 접근 시도하는 경우 포함)" },
          "503": { "description": "API가 현재 비활성화됨" }
        }
      }
    }
