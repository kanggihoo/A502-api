{
  "openapi": "3.0.3",
  "info": {
    "title": "Jira API - _91-webhooks",
    "version": "1.0.0",
    "description": "Jira의 \"동적 웹훅(dynamic webhooks)\"을 등록/조회/삭제/연장하는 API 모음. 특정 이슈에 대해 JQL 필터로 지정한 조건이 만족될 때 지정된 URL로 이벤트를 전송받도록 설정하는 기능이며, Connect 앱 또는 OAuth 2.0 앱만 호출할 수 있다."
  },
  "servers": [
    {
      "url": "https://{siteName}.atlassian.net",
      "variables": {
        "siteName": {
          "default": "ssafy",
          "description": "Jira Cloud 사이트 이름 (예: ssafy.atlassian.net)"
        }
      }
    }
  ],
  "security": [
    { "basicAuth": [] },
    { "oauth2": ["read:jira-work", "write:jira-work"] }
  ],
  "tags": [
    { "name": "Webhooks", "description": "Jira 동적 웹훅 등록/조회/삭제/연장 API" }
  ],
  "paths": {
    "/rest/api/3/webhook": {
      "get": {
        "summary": "앱의 동적 웹훅 목록 조회",
        "description": "현재 우리 앱이 Jira에 등록해 둔 웹훅 목록(이벤트 종류, JQL 필터, 대상 URL, 만료일 등)을 확인할 때 사용한다. 통합 알림/대시보드 기능에서 웹훅 설정 상태를 점검하거나, 팀 생성 자동화 시 이미 등록된 웹훅과 중복 여부를 확인하는 용도로 쓸 수 있다. 결과는 페이지 단위로 반환된다.",
        "operationId": "getDynamicWebhooksForApp",
        "tags": ["Webhooks"],
        "x-priority": "high",
        "security": [
          { "oauth2": ["read:jira-work", "manage:jira-webhook"] }
        ],
        "parameters": [
          {
            "name": "startAt",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" },
            "description": "반환할 결과 페이지의 시작 인덱스(오프셋)",
            "example": 0
          },
          {
            "name": "maxResults",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" },
            "description": "페이지당 최대 반환 개수",
            "example": 3
          }
        ],
        "responses": {
          "200": {
            "description": "요청이 성공한 경우, 앱이 등록한 웹훅 목록을 페이지네이션하여 반환",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "isLast": { "type": "boolean", "description": "마지막 페이지 여부" },
                    "maxResults": { "type": "integer", "description": "페이지당 최대 개수" },
                    "startAt": { "type": "integer", "description": "시작 인덱스" },
                    "total": { "type": "integer", "description": "전체 웹훅 개수" },
                    "values": {
                      "type": "array",
                      "description": "웹훅 객체 목록",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "integer", "description": "웹훅 ID" },
                          "events": {
                            "type": "array",
                            "items": { "type": "string" },
                            "description": "웹훅을 트리거하는 이벤트 목록"
                          },
                          "jqlFilter": { "type": "string", "description": "대상 이슈를 지정하는 JQL 필터" },
                          "url": { "type": "string", "description": "웹훅을 전송할 URL" },
                          "expirationDate": { "type": "string", "description": "웹훅 만료일(ISO 8601)" },
                          "fieldIdsFilter": {
                            "type": "array",
                            "items": { "type": "string" },
                            "description": "지정한 필드 변경 시에만 jira:issue_updated 전송"
                          },
                          "issuePropertyKeysFilter": {
                            "type": "array",
                            "items": { "type": "string" },
                            "description": "지정한 이슈 속성 키 변경 시에만 issue_property_set/issue_property_deleted 전송"
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "isLast": true,
                  "maxResults": 3,
                  "startAt": 0,
                  "total": 3,
                  "values": [
                    {
                      "events": ["jira:issue_updated", "jira:issue_created"],
                      "expirationDate": "2019-06-01T12:42:30.000+0000",
                      "fieldIdsFilter": ["summary", "customfield_10029"],
                      "id": 10000,
                      "jqlFilter": "project = PRJ",
                      "url": "https://your-app.example.com/webhook-received"
                    },
                    {
                      "events": ["jira:issue_created"],
                      "expirationDate": "2019-06-01T12:42:30.000+0000",
                      "id": 10001,
                      "jqlFilter": "issuetype = Bug",
                      "url": "https://your-app.example.com/webhook-received"
                    },
                    {
                      "events": ["issue_property_set"],
                      "expirationDate": "2019-06-01T12:42:30.000+0000",
                      "id": 10002,
                      "issuePropertyKeysFilter": ["my-issue-property-key"],
                      "jqlFilter": "project = PRJ",
                      "url": "https://your-app.example.com/webhook-received"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "요청 파라미터가 잘못된 경우",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorMessages": { "type": "array", "items": { "type": "string" } },
                    "errors": { "type": "object" },
                    "status": { "type": "integer" }
                  }
                },
                "example": {
                  "errorMessages": ["input parameter 'key' must be provided"],
                  "errors": {},
                  "status": 400
                }
              }
            }
          },
          "403": {
            "description": "호출자가 앱(Connect/OAuth 2.0)이 아닌 경우",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorMessages": { "type": "array", "items": { "type": "string" } },
                    "errors": { "type": "object" },
                    "status": { "type": "integer" }
                  }
                },
                "example": {
                  "errorMessages": ["input parameter 'key' must be provided"],
                  "errors": {},
                  "status": 403
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "동적 웹훅 등록",
        "description": "팀 생성 자동화 시 프로젝트별로 이슈 생성/수정, 코멘트 작성 등의 이벤트를 감지하기 위한 웹훅을 등록하는 핵심 API다. JQL 필터로 대상 이슈 범위를 제한할 수 있어 프로젝트 단위로 알림을 분리할 수 있다. non-public OAuth 앱의 경우 앱 소유자와 웹훅을 등록한 사용자가 일치해야 실제로 전달된다는 제약이 있다.",
        "operationId": "registerDynamicWebhooks",
        "tags": ["Webhooks"],
        "x-priority": "high",
        "security": [
          { "oauth2": ["write:jira-work", "manage:jira-webhook"] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["url", "webhooks"],
                "properties": {
                  "url": {
                    "type": "string",
                    "description": "웹훅을 전송할 URL. Connect 앱과 동일한 base URL 사용, 앱당 단일 URL만 등록 가능"
                  },
                  "webhooks": {
                    "type": "array",
                    "description": "등록할 웹훅 목록",
                    "items": {
                      "type": "object",
                      "required": ["events", "jqlFilter"],
                      "properties": {
                        "events": {
                          "type": "array",
                          "description": "웹훅을 트리거할 이벤트 목록",
                          "items": {
                            "type": "string",
                            "enum": [
                              "jira:issue_created",
                              "jira:issue_updated",
                              "jira:issue_deleted",
                              "comment_created",
                              "comment_updated",
                              "comment_deleted",
                              "issue_property_set",
                              "issue_property_deleted",
                              "sprint_created",
                              "sprint_updated",
                              "sprint_closed",
                              "sprint_deleted",
                              "sprint_started",
                              "jira:version_released",
                              "jira:version_unreleased",
                              "jira:version_created",
                              "jira:version_moved",
                              "jira:version_updated",
                              "jira:version_merged",
                              "jira:version_deleted"
                            ]
                          }
                        },
                        "fieldIdsFilter": {
                          "type": "array",
                          "items": { "type": "string" },
                          "description": "지정한 필드가 변경 이력에 포함될 때만 jira:issue_updated 전송. 미지정 시 모든 필드 변경에 대해 알림"
                        },
                        "issuePropertyKeysFilter": {
                          "type": "array",
                          "items": { "type": "string" },
                          "description": "지정한 이슈 속성 키 변경 시에만 issue_property_set/issue_property_deleted 전송"
                        },
                        "jqlFilter": {
                          "type": "string",
                          "description": "웹훅 대상 이슈를 지정하는 JQL 필터. 지원 필드: issueKey, project, issuetype, status, assignee, reporter, issue.property, cf[id](epic label만 지원). 지원 연산자: =, !=, IN, NOT IN"
                        }
                      }
                    }
                  }
                }
              },
              "example": {
                "url": "https://your-app.example.com/webhook-received",
                "webhooks": [
                  {
                    "events": ["jira:issue_created", "jira:issue_updated"],
                    "jqlFilter": "project = PRJ"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "요청이 성공한 경우, 각 웹훅 등록 결과를 반환",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "webhookRegistrationResult": {
                      "type": "array",
                      "description": "각 웹훅 등록 결과(createdWebhookId 또는 errors)",
                      "items": {
                        "type": "object",
                        "properties": {
                          "createdWebhookId": { "type": "integer", "description": "생성된 웹훅 ID" },
                          "errors": {
                            "type": "array",
                            "items": { "type": "string" },
                            "description": "등록 실패 시 오류 메시지"
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "webhookRegistrationResult": [
                    { "createdWebhookId": 1000 },
                    { "errors": ["The clause watchCount is unsupported"] },
                    { "createdWebhookId": 1001 }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "요청 본문이 잘못된 경우",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorMessages": { "type": "array", "items": { "type": "string" } },
                    "errors": { "type": "object" },
                    "status": { "type": "integer" }
                  }
                },
                "example": {
                  "errorMessages": ["input parameter 'key' must be provided"],
                  "errors": {},
                  "status": 400
                }
              }
            }
          },
          "403": {
            "description": "호출자가 앱(Connect/OAuth 2.0)이 아닌 경우",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorMessages": { "type": "array", "items": { "type": "string" } },
                    "errors": { "type": "object" },
                    "status": { "type": "integer" }
                  }
                },
                "example": {
                  "errorMessages": ["input parameter 'key' must be provided"],
                  "errors": {},
                  "status": 403
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "웹훅 ID로 삭제",
        "description": "호출한 앱이 등록한 웹훅만 삭제되며, 다른 앱이 생성한 웹훅 ID를 지정해도 무시된다. 프로젝트 종료, 웹훅 설정 변경, 정리 작업 등 부가적인 관리 시나리오에서 사용된다.",
        "operationId": "deleteWebhookById",
        "tags": ["Webhooks"],
        "x-priority": "medium",
        "security": [
          { "oauth2": ["write:jira-work", "manage:jira-webhook"] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["webhookIds"],
                "properties": {
                  "webhookIds": {
                    "type": "array",
                    "items": { "type": "integer" },
                    "description": "삭제할 웹훅 ID 목록"
                  }
                }
              },
              "example": {
                "webhookIds": [10000, 10001]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "요청이 정상적으로 접수되었음을 의미. 응답 본문 없음"
          },
          "400": {
            "description": "웹훅 ID 목록이 누락된 경우",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorMessages": { "type": "array", "items": { "type": "string" } },
                    "errors": { "type": "object" },
                    "status": { "type": "integer" }
                  }
                },
                "example": {
                  "errorMessages": ["input parameter 'key' must be provided"],
                  "errors": {},
                  "status": 400
                }
              }
            }
          },
          "403": {
            "description": "호출자가 앱(Connect/OAuth 2.0)이 아닌 경우",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorMessages": { "type": "array", "items": { "type": "string" } },
                    "errors": { "type": "object" },
                    "status": { "type": "integer" }
                  }
                },
                "example": {
                  "errorMessages": ["input parameter 'key' must be provided"],
                  "errors": {},
                  "status": 403
                }
              }
            }
          }
        }
      }
    },
    "/rest/api/3/webhook/refresh": {
      "put": {
        "summary": "웹훅 생명 연장",
        "description": "REST API를 통해 등록한 웹훅은 30일이 지나면 자동 만료되므로, 지속적인 웹훅 이벤트 수신을 위해서는 주기적으로 이 API를 호출해 만료일을 연장해야 한다. 다른 앱 소유이거나 존재하지 않는 웹훅 ID는 무시된다.",
        "operationId": "extendWebhookLife",
        "tags": ["Webhooks"],
        "x-priority": "high",
        "security": [
          { "oauth2": ["write:jira-work", "manage:jira-webhook"] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["webhookIds"],
                "properties": {
                  "webhookIds": {
                    "type": "array",
                    "items": { "type": "integer" },
                    "description": "연장할 웹훅 ID 목록"
                  }
                }
              },
              "example": {
                "webhookIds": [10000, 10001]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "요청이 성공한 경우, 연장된 새 만료일을 반환",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "expirationDate": { "type": "string", "description": "연장된 새 만료일(ISO 8601)" }
                  }
                },
                "example": {
                  "expirationDate": "2019-06-01T12:42:30.000+0000"
                }
              }
            }
          },
          "400": {
            "description": "요청이 잘못된 경우",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorMessages": { "type": "array", "items": { "type": "string" } },
                    "errors": { "type": "object" },
                    "status": { "type": "integer" }
                  }
                },
                "example": {
                  "errorMessages": ["input parameter 'key' must be provided"],
                  "errors": {},
                  "status": 400
                }
              }
            }
          },
          "403": {
            "description": "호출자가 앱(Connect/OAuth 2.0)이 아닌 경우",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorMessages": { "type": "array", "items": { "type": "string" } },
                    "errors": { "type": "object" },
                    "status": { "type": "integer" }
                  }
                },
                "example": {
                  "errorMessages": ["input parameter 'key' must be provided"],
                  "errors": {},
                  "status": 403
                }
              }
            }
          }
        }
      }
    },
    "/rest/api/3/webhook/failed": {
      "get": {
        "summary": "실패한 웹훅 조회",
        "description": "웹훅 전달이 반복적으로 실패한 이력을 확인하는 모니터링/디버깅용 API다. 실패 후 72시간이 지나면 더 이상 조회되지 않을 수 있으며, 가장 오래된 실패 건부터 반환된다. failedAfter 값 또는 응답의 next URL을 이용한 커서 기반 페이지네이션을 사용한다.",
        "operationId": "getFailedWebhooks",
        "tags": ["Webhooks"],
        "x-priority": "medium",
        "security": [
          { "oauth2": ["read:jira-work", "manage:jira-webhook"] }
        ],
        "parameters": [
          {
            "name": "maxResults",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" },
            "description": "페이지당 최대 반환 개수. 동일 실패 시각을 가진 레코드가 페이지 경계에서 분리되는 경우 해당 지시값을 무시하고 모두 포함",
            "example": 100
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" },
            "description": "이 시각(UNIX epoch ms) 이후 발생한 실패만 반환",
            "example": 1573118132000
          }
        ],
        "responses": {
          "200": {
            "description": "요청이 성공한 경우, 실패한 웹훅 목록을 커서 기반 페이지네이션으로 반환",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "values": {
                      "type": "array",
                      "description": "실패한 웹훅 목록",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string", "description": "실패 레코드 ID" },
                          "body": { "type": "string", "description": "전송하려던 웹훅 본문" },
                          "url": { "type": "string", "description": "전송 대상 URL" },
                          "failureTime": { "type": "integer", "description": "실패 시각(UNIX epoch ms)" }
                        }
                      }
                    },
                    "maxResults": { "type": "integer", "description": "페이지당 최대 개수" },
                    "next": { "type": "string", "description": "다음 페이지 조회 URL" }
                  }
                },
                "example": {
                  "values": [
                    { "id": "1", "body": "{\"data\":\"webhook data\"}", "url": "https://example.com", "failureTime": 1573118132000 },
                    { "id": "2", "url": "https://example.com", "failureTime": 1573540473480 }
                  ],
                  "maxResults": 100,
                  "next": "https://your-domain.atlassian.net/rest/api/3/webhook/failed?failedAfter=1573540473480&maxResults=100"
                }
              }
            }
          },
          "400": {
            "description": "잘못된 요청",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorMessages": { "type": "array", "items": { "type": "string" } },
                    "errors": { "type": "object" },
                    "status": { "type": "integer" }
                  }
                },
                "example": {
                  "errorMessages": ["input parameter 'key' must be provided"],
                  "errors": {},
                  "status": 400
                }
              }
            }
          },
          "403": {
            "description": "호출자가 Connect 앱이 아닌 경우 (OAuth 2.0 앱은 이 API 사용 불가)",
            "content": {
              "application/json": {
                "schema": {
