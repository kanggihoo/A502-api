{
  "openapi": "3.0.3",
  "info": {
    "title": "Jira API - _49-issues",
    "version": "1.0.0",
    "description": "Jira 이슈(및 서브태스크)의 생성/조회/수정/삭제, 상태 전환, 담당자 배정, 변경 이력(changelog) 조회, 이메일 알림 발송 등 이슈 라이프사이클 전반을 다루는 API 모음."
  },
  "servers": [
    {
      "url": "https://{siteName}.atlassian.net",
      "variables": {
        "siteName": {
          "default": "ssafy",
          "description": "Jira Cloud 사이트 이름 (예: ssafy.atlassian.net)"
        }
      }
    }
  ],
  "security": [
    { "basicAuth": [] },
    { "oauth2": ["read:jira-work", "write:jira-work"] }
  ],
  "tags": [
    { "name": "Issue changelogs" },
    { "name": "Issues" },
    { "name": "Issue notifications" },
    { "name": "Issue transitions" },
    { "name": "Issue metadata" }
  ],
  "paths": {
    "/rest/api/3/changelog/bulkfetch": {
      "post": {
        "summary": "Bulk fetch changelogs",
        "description": "최대 1000개 이슈의 changelog를 changelog 날짜와 이슈 ID 기준(오름차순)으로 정렬하여 페이지네이션된 형태로 반환한다. 이슈는 ID 또는 key로 지정하며, 최대 10개의 필드 ID로 changelog를 필터링할 수 있다. 대시보드에서 이슈 상태 변경 이력을 통합 조회할 때 유용하다.",
        "operationId": "bulkFetchChangelogs",
        "tags": ["Issue changelogs"],
        "x-priority": "high",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["issueIdsOrKeys"],
                "properties": {
                  "fieldIds": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "changelog를 필터링할 필드 ID 목록 (최대 10개)"
                  },
                  "issueIdsOrKeys": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "changelog를 조회할 이슈 ID/key 목록 (최대 1000개)"
                  },
                  "maxResults": {
                    "type": "integer",
                    "description": "페이지당 최대 반환 개수"
                  },
                  "nextPageToken": {
                    "type": "string",
                    "description": "페이지네이션 커서"
                  }
                }
              },
              "example": {
                "fieldIds": ["fieldId"],
                "issueIdsOrKeys": ["10100"],
                "maxResults": 50,
                "nextPageToken": "UxAQBFRF"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "issueChangeLogs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "issueId": { "type": "string", "description": "이슈 ID" },
                          "changeHistories": { "type": "array", "description": "변경 이력 배열", "items": { "type": "object" } }
                        }
                      },
                      "description": "이슈별 changelog 목록"
                    },
                    "nextPageToken": { "type": "string", "description": "다음 페이지 커서" }
                  }
                },
                "example": {
                  "issueChangeLogs": [
                    {
                      "issueId": "10100",
                      "changeHistories": [
                        {
                          "id": "10001",
                          "author": {
                            "accountId": "5b10a2844c20165700ede21g",
                            "displayName": "Mia Krystof"
                          },
                          "created": 1492070429,
                          "items": [
                            { "field": "fields", "fieldId": "fieldId", "fieldtype": "jira", "fromString": "old summary", "toString": "new summary" }
                          ]
                        }
                      ]
                    }
                  ],
                  "nextPageToken": "UxAQBFRF"
                }
              }
            }
          },
          "400": { "description": "issue ID/key 미포함 또는 1000개 초과 요청" }
        }
      }
    },
    "/rest/api/3/issue": {
      "post": {
        "summary": "Create issue",
        "description": "이슈나 서브태스크를 생성하며, 생성 시 기본 시작 상태가 아닌 다른 워크플로 단계로 전환(transition)하거나 이슈 속성을 함께 설정할 수 있다. description, environment, textarea 타입 커스텀 필드는 Atlassian Document Format(ADF)을 사용해야 한다. 서브태스크 생성 시 issueType을 서브태스크 타입으로, parent에 부모 이슈 ID/key를 지정해야 한다.",
        "operationId": "createIssue",
        "tags": ["Issues"],
        "x-priority": "high",
        "parameters": [
          {
            "name": "updateHistory",
            "in": "query",
            "required": false,
            "schema": { "type": "boolean" },
            "description": "이슈 생성 프로젝트를 사용자의 '최근 조회' 목록에 추가할지 여부",
            "example": true
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fields": {
                    "type": "object",
                    "description": "설정할 이슈 화면 필드 목록 (update와 필드 중복 불가)"
                  },
                  "historyMetadata": { "description": "추가 이슈 이력 정보" },
                  "properties": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": { "type": "string", "description": "속성 key" },
                        "value": { "description": "속성 value" }
                      }
                    },
                    "description": "추가/수정할 이슈 속성 목록"
                  },
                  "transition": { "description": "수행할 transition 정보" },
                  "update": { "type": "object", "description": "필드별 수행할 오퍼레이션 맵 (fields와 필드 중복 불가)" }
                }
              },
              "example": {
                "fields": {
                  "project": { "key": "ED" },
                  "summary": "Main order flow broken",
                  "issuetype": { "name": "Bug" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string", "description": "생성된 이슈 ID" },
                    "key": { "type": "string", "description": "생성된 이슈 key" },
                    "self": { "type": "string", "description": "이슈 리소스 URL" }
                  }
                },
                "example": {
                  "id": "10000",
                  "key": "ED-24",
                  "self": "https://your-domain.atlassian.net/rest/api/3/issue/10000",
                  "transition": { "status": 200, "errorCollection": { "errorMessages": [], "errors": {} } }
                }
              }
            }
          },
          "400": {
            "description": "필수 필드 누락/잘못된 값/생성 불가한 필드 포함 등",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "errorMessages": { "type": "array", "items": { "type": "string" } }, "errors": { "type": "object" } } },
                "example": { "errorMessages": ["Field 'priority' is required"], "errors": {} }
              }
            }
          },
          "401": { "description": "인증 정보 없음/오류" },
          "403": { "description": "권한 없음" },
          "422": { "description": "설정 문제로 생성 불가" }
        }
      }
    },
    "/rest/api/3/issue/bulk": {
      "post": {
        "summary": "Bulk create issue",
        "description": "여러 이슈를 한 번의 요청으로 생성하며, 각 이슈에 대해 개별적으로 transition 적용과 속성 설정이 가능하다. 단일 생성 API(Create issue)와 동일한 fields/update 규칙을 따른다. 일부 이슈 생성이 실패해도 나머지는 성공할 수 있다.",
        "operationId": "bulkCreateIssue",
        "tags": ["Issues"],
        "x-priority": "high",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "issueUpdates": {
                    "type": "array",
                    "description": "생성할 이슈 정보 목록 (최대 50개, 각 항목은 Create issue와 동일한 구조: fields, historyMetadata, properties, transition, update)",
                    "items": {
                      "type": "object",
                      "properties": {
                        "fields": { "type": "object" },
                        "historyMetadata": {},
                        "properties": { "type": "array", "items": { "type": "object" } },
                        "transition": {},
                        "update": { "type": "object" }
                      }
                    }
                  }
                }
              },
              "example": {
                "issueUpdates": [
                  { "fields": { "project": { "key": "ED" }, "summary": "issue 1", "issuetype": { "name": "Bug" } } },
                  { "fields": { "project": { "key": "ED" }, "summary": "issue 2", "issuetype": { "name": "Task" } } }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "issues": { "type": "array", "description": "생성 성공한 이슈 목록", "items": { "type": "object" } },
                    "errors": { "type": "array", "description": "생성 실패한 항목의 오류 정보", "items": { "type": "object" } }
                  }
                },
                "example": {
                  "issues": [
                    { "id": "10000", "key": "ED-24", "self": "https://your-domain.atlassian.net/rest/api/3/issue/10000" },
                    { "id": "10001", "key": "ED-25", "self": "https://your-domain.atlassian.net/rest/api/3/issue/10001" }
                  ],
                  "errors": []
                }
              }
            }
          },
          "400": {
            "description": "모든 요청이 유효하지 않음",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "issues": { "type": "array" }, "errors": { "type": "array" } } },
                "example": {
                  "issues": [],
                  "errors": [
                    { "elementErrors": { "errorMessages": [], "errors": { "issuetype": "The issue type selected is invalid." } }, "failedElementNumber": 0, "status": 400 }
                  ]
                }
              }
            }
          },
          "401": { "description": "인증 정보 없음/오류" }
        }
      }
    },
    "/rest/api/3/issue/bulkfetch": {
      "post": {
        "summary": "Bulk fetch issues",
        "description": "최대 100개의 이슈를 ID 또는 key로 조회한다. 식별자가 일치하지 않으면 대소문자 무시 검색 및 이동된 이슈 확인을 수행한다. 결과는 id 오름차순으로 반환되며, 조회 실패한 이슈는 issueErrors에 별도로 담긴다. 통합 대시보드에서 여러 이슈 상태를 한 번에 가져올 때 유용하다.",
        "operationId": "bulkFetchIssues",
        "tags": ["Issues"],
        "x-priority": "high",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["issueIdsOrKeys"],
                "properties": {
                  "expand": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "추가 정보 확장 옵션 (renderedFields, names, schema, transitions, operations, editmeta, changelog, versionedRepresentations)"
                  },
                  "fields": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "반환할 필드 목록, 기본값은 *navigable"
                  },
                  "fieldsByKeys": {
                    "type": "boolean",
                    "description": "필드를 key로 참조할지 여부",
                    "default": false
                  },
                  "issueIdsOrKeys": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "조회할 이슈 ID/key 배열 (최대 100개)"
                  },
                  "properties": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "포함할 이슈 속성 키 목록 (최대 5개)"
                  }
                }
              },
              "example": {
                "issueIdsOrKeys": ["EX-1", "EX-2"],
                "fields": ["summary", "assignee"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "expand": { "type": "string", "description": "확장 정보" },
                    "issues": { "type": "array", "description": "조회된 이슈 목록", "items": { "type": "object" } },
                    "issueErrors": { "type": "array", "description": "조회 실패한 이슈 오류 목록", "items": { "type": "object" } }
                  }
                },
                "example": {
                  "expand": "schema,names",
                  "issueErrors": [],
                  "issues": [
                    {
                      "id": "10002",
                      "key": "EX-1",
                      "self": "https://your-domain.atlassian.net/rest/api/3/issue/10002",
                      "fields": { "summary": "My first example issue" }
                    }
                  ]
                }
              }
            }
          },
          "400": { "description": "이슈 ID/key 미포함 또는 100개 초과 요청" },
          "401": { "description": "인증 정보 없음/오류" }
        }
      }
    },
    "/rest/api/3/issue/{issueIdOrKey}": {
      "get": {
        "summary": "Get issue",
        "description": "이슈 ID 또는 key로 상세 정보를 조회한다. 식별자가 일치하지 않으면 대소문자 무시 검색과 이동된 이슈 확인을 수행하며, 매칭되면 302 리다이렉트 없이 바로 상세 정보를 반환한다. 통합 알림/대시보드에서 이슈 상태, 코멘트, 워처, 첨부파일 등을 조회하는 핵심 API다.",
        "operationId": "getIssue",
        "tags": ["Issues"],
        "x-priority": "high",
        "parameters": [
          {
            "name": "issueIdOrKey",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "이슈의 ID 또는 key",
            "example": "EX-1"
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "schema": { "type": "array", "items": { "type": "string" } },
            "description": "반환할 필드 목록(콤마 구분), 기본값은 전체 필드",
            "example": "summary,comment"
          },
          {
            "name": "fieldsByKeys",
            "in": "query",
            "required": false,
            "schema": { "type": "boolean", "default": false },
            "description": "필드를 key로 참조할지 여부",
            "example": false
          },
          {
            "name": "expand",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "추가 정보 확장(renderedFields, names, schema, transitions, editmeta, changelog, versionedRepresentations)",
            "example": "changelog"
          },
          {
            "name": "properties",
            "in": "query",
            "required": false,
            "schema": { "type": "array", "items": { "type": "string" } },
            "description": "반환할 이슈 속성 목록",
            "example": "*all"
          },
          {
            "name": "updateHistory",
            "in": "query",
            "required": false,
            "schema": { "type": "boolean" },
            "description": "최근 조회 프로젝트 목록에 추가할지 여부",
            "example": true
          },
          {
            "name": "failFast",
            "in": "query",
            "required": false,
            "schema": { "type": "boolean", "default": false },
            "description": "필드 로드 실패 시 즉시 실패할지 여부",
            "example": false
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string", "description": "이슈 ID" },
                    "key": { "type": "string", "description": "이슈 key" },
                    "self": { "type": "string", "description": "이슈 리소스 URL" },
                    "fields": { "type": "object", "description": "이슈 필드 값(watcher, attachment, comment, issuelinks, worklog 등)" }
                  }
                },
                "example": {
                  "id": "10002",
                  "key": "ED-1",
                  "self": "https://your-domain.atlassian.net/rest/api/3/issue/10002",
                  "fields": {
                    "watcher": { "isWatching": false, "watchCount": 1 },
                    "description": { "type": "doc", "version": 1, "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Main order flow broken" }] }] },
                    "comment": [
                      { "id": "10000", "author": { "displayName": "Mia Krystof" }, "created": "2021-01-17T12:34:00.000+0000" }
                    ]
                  }
                }
              }
            }
          },
          "401": { "description": "인증 정보 없음/오류" },
          "404": { "description": "이슈를 찾을 수 없거나 조회 권한 없음" }
        }
      },
      "put": {
        "summary": "Edit issue",
        "description": "이슈 필드와 속성을 수정한다. 이슈 상태 전환(transition)은 이 API에서 지원하지 않으며 무시되므로 Transition issue API를 별도로 사용해야 한다. description, environment, textarea 타입 커스텀 필드는 ADF 콘텐츠를 사용해야 한다.",
        "operationId": "editIssue",
        "tags": ["Issues"],
        "x-priority": "high",
        "parameters": [
          {
            "name": "issueIdOrKey",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "이슈의 ID 또는 key",
            "example": "EX-1"
          },
          {
            "name": "notifyUsers",
            "in": "query",
            "required": false,
            "schema": { "type": "boolean" },
            "description": "워처에게 수정 알림 이메일 발송 여부",
            "example": true
          },
          {
            "name": "overrideScreenSecurity",
            "in": "query",
            "required": false,
            "schema": { "type": "boolean" },
            "description": "화면 보안 설정을 무시하고 숨겨진 필드 수정 허용(Connect/Forge 앱 전용)",
            "example": false
          },
          {
            "name": "overrideEditableFlag",
            "in": "query",
            "required": false,
            "schema": { "type": "boolean" },
            "description": "편집 불가 필드 수정 허용(Connect/Forge 앱 전용)",
            "example": false
          },
          {
            "name": "returnIssue",
            "in": "query",
            "required": false,
            "schema": { "type": "boolean" },
            "description": "응답에 수정된 이슈 반환 여부",
            "example": true
          },
          {
            "name": "expand",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "returnIssue가 true일 때 사용할 expand 옵션",
            "example": "names"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fields": { "type": "object", "description": "수정할 필드 목록 (update와 중복 불가)" },
                  "historyMetadata": { "description": "추가 이력 정보" },
                  "properties": {
                    "type": "array",
                    "items": { "type": "object", "properties": { "key": { "type": "string" }, "value": {} } },
                    "description": "추가/수정할 이슈 속성"
                  },
                  "transition": { "description": "transition 정보 (이 API에서는 무시됨)" },
                  "update": { "type": "object", "description": "필드별 오퍼레이션 맵 (fields와 중복 불가)" }
                }
              },
              "example": { "fields": { "summary": "새 이슈 요약" } }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK (returnIssue=true인 경우, Get issue API와 동일한 형식의 이슈 객체 반환)",
            "content": {
