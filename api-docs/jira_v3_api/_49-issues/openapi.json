    "/rest/api/3/issue/{issueIdOrKey}/transitions": {
      "get": {
        "summary": "Get transitions",
        "description": "이슈의 현재 상태 기준으로 전체 또는 특정 transition 정보를 반환한다. 상태 전환 UI를 만들거나 자동화 워크플로에서 다음 가능한 상태를 파악할 때 사용한다.",
        "operationId": "getTransitions",
        "tags": ["Issue transitions"],
        "x-priority": "high",
        "parameters": [
          {
            "name": "issueIdOrKey",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "이슈의 ID 또는 key",
            "example": "EX-1"
          },
          {
            "name": "expand",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "transitions.fields 지정 시 전환 화면 필드 정보 포함",
            "example": "transitions.fields"
          },
          {
            "name": "transitionId",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "특정 transition ID",
            "example": "711"
          },
          {
            "name": "skipRemoteOnlyCondition",
            "in": "query",
            "required": false,
            "schema": { "type": "boolean" },
            "description": "Hide From User Condition이 걸린 transition 포함 여부(Connect/Forge 전용)",
            "example": false
          },
          {
            "name": "includeUnavailableTransitions",
            "in": "query",
            "required": false,
            "schema": { "type": "boolean" },
            "description": "조건 실패한 transition도 포함할지 여부",
            "example": false
          },
          {
            "name": "sortByOpsBarAndStatus",
            "in": "query",
            "required": false,
            "schema": { "type": "boolean" },
            "description": "ops-bar 순서/상태 카테고리 기준 정렬 여부",
            "example": false
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "transitions": {
                      "type": "array",
                      "description": "가능한 transition 목록",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string", "description": "transition ID" },
                          "name": { "type": "string", "description": "transition 이름" },
                          "to": { "type": "object", "description": "전환될 상태 정보" }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "transitions": [
                    {
                      "id": "2",
                      "name": "Close Issue",
                      "hasScreen": false,
                      "isAvailable": true,
                      "to": { "id": "10000", "name": "In Progress" }
                    }
                  ]
                }
              }
            }
          },
          "401": { "description": "인증 정보 없음/오류" },
          "404": { "description": "이슈 없음/권한 없음" }
        }
      },
      "post": {
        "summary": "Transition issue",
        "description": "이슈의 상태를 전환하며, 전환 화면(screen)이 있는 경우 fields나 update로 해당 화면의 필드도 함께 갱신한다. 전환 가능한 필드 정보는 Get transitions API의 transitions.fields expand로 확인한다. 프로젝트 운영 지원(상태 전환 자동화)의 핵심 API다.",
        "operationId": "transitionIssue",
        "tags": ["Issue transitions"],
        "x-priority": "high",
        "parameters": [
          {
            "name": "issueIdOrKey",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "이슈의 ID 또는 key",
            "example": "EX-1"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["transition"],
                "properties": {
                  "fields": { "type": "object", "description": "전환 화면의 필드 값 (update와 중복 불가)" },
                  "historyMetadata": { "description": "추가 이력 정보" },
                  "properties": { "type": "array", "items": { "type": "object" }, "description": "추가/수정할 이슈 속성" },
                  "transition": { "type": "object", "description": "수행할 transition 정보(id 등)" },
                  "update": { "type": "object", "description": "필드별 오퍼레이션 맵 (fields와 중복 불가)" }
                }
              },
              "example": {
                "transition": { "id": "2" },
                "fields": { "resolution": { "name": "Fixed" } }
              }
            }
          }
        },
        "responses": {
          "204": { "description": "전환 성공 시 본문 없이 반환" },
          "400": { "description": "transition 미지정, 권한 없음, 화면에 없는 필드 지정, fields/update 중복 지정" },
          "401": { "description": "인증 정보 없음/오류" },
          "404": { "description": "이슈 없음/권한 없음" },
          "409": { "description": "충돌하는 업데이트" },
          "413": { "description": "코멘트/워크로그/첨부파일/이슈링크 등 이슈별 한도 초과" },
          "422": { "description": "설정 문제로 생성 불가" }
        }
      }
    },
