          {
            "name": "issueIdOrKey",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "이슈의 ID 또는 key",
            "example": "TT-1"
          },
          {
            "name": "startAt",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 0 },
            "description": "페이지 시작 인덱스",
            "example": 2
          },
          {
            "name": "maxResults",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" },
            "description": "페이지당 최대 반환 개수",
            "example": 2
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "isLast": { "type": "boolean", "description": "마지막 페이지 여부" },
                    "maxResults": { "type": "integer", "description": "페이지당 최대 개수" },
                    "startAt": { "type": "integer", "description": "페이지 시작 인덱스" },
                    "total": { "type": "integer", "description": "전체 changelog 개수" },
                    "values": { "type": "array", "description": "changelog 항목 목록", "items": { "type": "object" } }
                  }
                },
                "example": {
                  "isLast": false,
                  "maxResults": 2,
                  "startAt": 2,
                  "total": 5,
                  "values": [
                    {
                      "id": "10001",
                      "author": { "accountId": "5b10a2844c20165700ede21g", "displayName": "Mia Krystof" },
                      "created": "1970-01-18T06:27:50.429+0000",
                      "items": [{ "field": "fields", "fieldtype": "jira", "fieldId": "fieldId", "fromString": "", "toString": "label-1" }]
